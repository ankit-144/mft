direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  ext: {style.fill: "#eceff1"; style.stroke: "#90a4ae"}
  go: {style.fill: "#e3f2fd"; style.stroke: "#1976d2"}
  py: {style.fill: "#ede7f6"; style.stroke: "#5e35b1"}
  store: {style.fill: "#e8f5e9"; style.stroke: "#2e7d32"}
  mem: {style.fill: "#fff8e1"; style.stroke: "#f9a825"}
  ctl: {style.fill: "#e5e7eb"; style.stroke: "#37474f"}
  bad: {style.fill: "#ffebee"; style.stroke: "#c62828"}
}

q: "The central design decision (Plan.md 4): inference PULLS candles at every\nminute close. The alternative was ingestion PUSHING bar-close events." {
  style.bold: true
  style.font-size: 20
}

# --- left half: the option that was rejected ------------------------------

rejected: "REJECTED - ingestion pushes at the bar close" {
  style.stroke-dash: 3

  l_app: "ingestion (Go)\nservices/ingestion/candles.go\nCandleStore.Append(candle)" {class: go}
  l_bus: "message broker / bus\nan external process to run and\nsupervise - Plan.md 1 forbids it" {class: ext}
  l_sub: "inference subscriber\nmust be connected at the very\ninstant the bar closes" {class: py}
  l_off: "offsets, acks, last_seen_candle_ts\nprocess-local reconciliation\nfor every subscriber that was down" {class: mem}
  l_appeal: "the appeal: the bar is in hand\nthe moment it closes - no read,\nno glob, no sort" {class: ctl}
  l_fail: "if push loses an event there is\nno Decision, no log line, no retry;\nthe minute is a hole that only\nan offset can ever repair" {class: bad}
  l_verdict: "rejected: latency bought at a 1-minute\ncadence is latency nobody pays for,\nand the offsets would be cross-process\nstate - Plan.md 4: fluxKV is a per-process\ncache, never a message bus" {class: ctl}

  l_app -> l_bus: "bar-close event"
  l_bus -> l_sub: "deliver, if it is connected"
  l_sub -> l_off: "ack"
  l_off -> l_sub: {label: "reconnect, replay\nfrom last_seen"; style.stroke-dash: 4}
  l_bus -> l_appeal: "what push actually buys"
  l_off -> l_fail: "a subscriber gap"
  l_fail -> l_verdict: "so it was not built"
}

# --- right half: what was built -------------------------------------------

built: "BUILT - inference pulls at each minute close" {
  r_sched: "MinuteScheduler.run(stop)\nservices/inference/app/loop.py\nsleeps to the next boundary,\nnot for a fixed period" {class: py}
  r_pull: "CandleStore.tail(symbol,\ncontext_rows + WARMUP_ROWS)\nDuckDBCandleStore._tail_sync\n-> _TAIL_SQL" {class: py}
  r_glob: "data/candles/symbol=X/date=*/\npart-*.parquet\nCandleReader.Glob(symbol)\ncore/storage/reader.go:188" {class: store}
  r_build: "FeatureBuilder.build(candles)\n-> FeatureTable\ntable.context(wanted) drops\nWARMUP_ROWS = 60" {class: py}
  r_pred: "Predictor.predict(context, horizon)\nscore in [-1, 1]" {class: py}
  r_sig: "_maybe_signal\n-> ExecutionClient.submit\nPOST /v1/signals" {class: ctl}
  r_dry: "inference.dry_run = true\nthe signal is logged in full,\nnothing leaves this process" {class: mem}
  r_fail: "if the pull finds too few candles:\nempty -> NO_CONTEXT, short ->\nBAD_CONTEXT. No signal is built;\nthe other symbols and the next\nminute still run" {class: bad}

  r_sched -> r_pull: "evaluate(symbol):\none Decision per instrument"
  r_pull -> r_glob: "reads published files only,\nnever .inflight-*.parquet"
  r_pull -> r_build: "candles"
  r_build -> r_pred: "context rows"
  r_pred -> r_sig: "abs(score) >= score_threshold"
  r_sig -> r_dry: "the dry_run branch"
  r_pull -> r_fail: "no candles stored"
  r_build -> r_fail: {label: "fewer rows than the model\nneeds -> FeatureError"; style.stroke-dash: 4}

  why: "consequences of pull" {
    style.stroke-dash: 3

    c_miss: "a missed minute is free:\nthe next boundary runs again and\npulls whatever is now stored.\nThere is no queue to back up" {class: store}
    c_restart: "stateless and restartable:\nthe state is in Parquet, not in the\nprocess, so a restart mid-minute\nneeds no handshake" {class: store}
    c_lat: "TICK_PERIOD = 1 minute is a\nproperty of the 1m candle, not a\nknob - so sub-second push\nlatency buys nothing" {class: py}
    c_cost: "the cost: the newest published\ncandle lags the clock by up to one\nstorage.flush_interval_seconds,\nbecause part-* is renamed at flush" {class: bad}
    c_guard: "staleness_guard(flush_interval_seconds)\n= max(DEFAULT_MAX_CONTEXT_AGE = 5m,\nflush_interval_seconds + STALENESS_MARGIN = 1m)\nflush_interval_seconds: 300 -> 6m\n<= 0 -> 5m\nwired by runtime.build_runtime()" {class: py}

    c_lat -> c_cost: "so the lag is real"
    c_cost -> c_guard: "derived from the flush\ninterval, never guessed"
  }
}

footer: "Derived from\n  Plan.md 4 - the central design decision\n  services/inference/app/loop.py\n    MinuteScheduler, staleness_guard, Outcome\n  services/inference/app/candles.py\n    CandleStore.tail, DuckDBCandleStore, PART_GLOB\n  services/inference/app/runtime.py - build_runtime\n  core/storage/reader.go - Glob, Candles\nNever built, and named only to say so:\n  broker, subscriber, offsets" {
  style.fill: "#eceff1"
  style.stroke: "#90a4ae"
  style.font-size: 13
}