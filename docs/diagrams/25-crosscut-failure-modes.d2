direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  ext: {style.fill: "#eceff1"; style.stroke: "#90a4ae"}
  go: {style.fill: "#e3f2fd"; style.stroke: "#1976d2"}
  py: {style.fill: "#ede7f6"; style.stroke: "#5e35b1"}
  lib: {style.fill: "#e0f2f1"; style.stroke: "#00897b"}
  store: {style.fill: "#e8f5e9"; style.stroke: "#2e7d32"}
  mem: {style.fill: "#fff8e1"; style.stroke: "#f9a825"}
  ctl: {style.fill: "#e5e7eb"; style.stroke: "#37474f"}
  bad: {style.fill: "#ffebee"; style.stroke: "#c62828"}
}

title: "Failure modes — grouped by what the platform DOES about it.\nRetry · fail fast · fail closed · drop and count · surface · refuse to start · bound · shut down." {
  style.bold: true
  style.font-size: 20
}

kite: "KITE CONNECT — the only external trigger on this page.\nWebSocket wss://ws.kite.trade (binary LTP + a ~30s ping control frame)\nand the REST historical API, which is the one that answers 429." {
  class: ext
}

# ================================================================ BAND 1 ====
retry: "RETRY WITH BACKOFF — the failure is expected to be transient" {
  ws_dead: "socket dies\n90s with no read, or ReadMessage fails,\nor subscribe / mode / pong cannot be written\n→ wrapped broker.ERR_UNAVAILABLE\ncontext.AfterFunc(ctx, conn.Close) unblocks the read at once" {
    class: bad
  }

  stream_backoff: "core/broker backoffFor(attempt, reconnectBase, maxBackoff) — stream.go:325\ndelay = base, then for i < attempt: saturate at max, else delay *= 2\nfinal guard: delay > max OR delay <= 0 returns max\nbase = defaultReconnectBase 1s, a package constant, NOT a config key\nmax = broker.reconnect_max_backoff_seconds, default 60\n1s → 2s → 4s → 8s → 16s → 32s → 60s → 60s … attempt 6 onward is flat\ndoubling is iterative, never a shift: 63 shifts overflow int64 negative,\nand a negative timer fires at once — an outage becomes a hot loop\non the way out k.reconnects.Add(1) and one Warn" {
    class: go
  }

  supervise: "Pipeline.supervise(ctx, upstream) — pipeline.go:510\nStream returned at all? log 'broker stream returned, restarting' with\nattempt, backoff and err, then re-invoke it. defer close(upstream)\nis what makes the drain safe.\nWhy a second layer exists: every SESSION error is swallowed and retried\nforever inside Stream, so an unsupervised return left the process up,\n/healthz green, and storing nothing." {
    class: go
  }

  sup_backoff: "Pipeline.backoffFor(attempt) — pipeline.go:539\ndefaultReconnectBase 1s → defaultReconnectMax 60s, doubling,\nsaturating, same iterative-overflow reason.\ndefaultReconnectMax mirrors broker.reconnect_max_backoff_seconds and is\noverridden from it when the config is non-zero." {
    class: ctl
  }

  throttle: "429 from /data/historical → classified broker.ERR_RATE_LIMIT\nmft_jobs_backfill_throttles_total.Inc()\nRetryable on purpose: a Kite access token lives for a trading day,\nso exhausting attempts on a 401 is right and on a 429 is not." {
    class: bad
  }

  jobs_backoff: "Backoff.Delay(n) = base*2^n clamped to max, then FullJitter → [d/2, d]\nbase 500ms, max 30s — backoff.go:37, 72\nfloat64 shift then clamp, so a large n cannot wrap to a negative\n(i.e. immediate) delay. The lower half of the window is deliberate:\nfull jitter to zero can busy-loop a rate-limited endpoint, while never\ndropping below half still spreads a synchronised herd over a factor of 2." {
    class: ctl
  }

  giveup: "maxAttempts = 4 exhausted → 'backfill SEG: 4 attempts exhausted'\nrunSymbol records it and moves to the NEXT segment.\nRunBackfill: 0 candles and any failure → wraps jobs.ERR_NO_HISTORY\nand mft_jobs_backfill_runs_failed_total, because a silent zero-candle\nweek is worse than a loud one. Whatever DID land is on disk, so the\nnext run resumes — the unit of work is the segment, not the run." {
    class: bad
  }

  ws_dead -> stream_backoff: "session() returned"
  stream_backoff -> stream_backoff: "timer fires → attempt++ → re-dial"
  stream_backoff -> supervise: "pre-flight failures only: ERR_AUTH, ERR_INSTRUMENT_NOT_FOUND, ctx.Err()"
  supervise -> sup_backoff: "delay := p.backoffFor(attempt)"
  sup_backoff -> supervise: "p.wait(ctx, delay)"
  throttle -> jobs_backoff: "attempt > 0"
  jobs_backoff -> giveup: "4 attempts gone"
  giveup -> kite: "next segment, next run"
}

# ================================================================ BAND 2 ====
fatal: "FAIL FAST AS NON-RETRYABLE — a dead token will not fix itself on the next segment" {
  is_fatal: "isFatal(err) — worker.go:442\nerrors.Is(err, broker.ERR_AUTH) || errors.Is(err, broker.ERR_INSTRUMENT_NOT_FOUND)\nshort-circuits the retry loop: it costs ZERO attempts, not four" {
    class: bad
  }

  break_sym: "runSymbol break — worker.go:309\nstop burning rate limit on that one symbol\nthis is the contrast with the backoff band: a rate limit is a request\nto wait, an expired token is a request to stop.\nA per-symbol failure never aborts the run — one delisted ticker must\nnot cost the other two their history." {
    class: go
  }

  contrast: |md

    The other sentinels cost exactly one attempt each and are retried:

    `ERR_RATE_LIMIT` — throttled, wait and try again

    `ERR_UNAVAILABLE` — transport or 5xx, the socket is the volatile thing

    `ERR_INVALID_ORDER` — returned by the local frame-length check, and it is
    reachable on every one of the 13 segments, so giving up on the symbol
    would throw away 12 that are fine

  | { class: lib }

  is_fatal -> break_sym: "true"
  break_sym -> contrast: "false → one attempt, next segment"
  contrast -> retry.giveup: "and only after 4"
}

# ================================================================ BAND 3 ====
closed: "FAIL CLOSED — the inference loop returns a Decision for every expected failure and raises for none" {
  tick: "Loop.tick() — loop.py:293\nfor symbol in self.instruments: try evaluate(symbol)\nexcept Exception: logger.exception, Outcome.ERROR, carry on\nReturns one Decision per instrument in configured order. Docstring:\n'never raises'." {
    class: py
  }

  outcomes: "evaluate() outcomes — loop.py:336-417, all `return`, none `raise`\nNOT_LOADED  predictor.is_loaded() is false\nNO_CONTEXT  the store returned no candles for this symbol\nSTALE_CONTEXT  newest candle older than the staleness guard\nBAD_CONTEXT  FeatureError, or InvalidContextError from the model\nERROR  candle read failed, or the model faulted\nSEND_FAILED  the bounded client retries are spent on the POST\nAll six are in _FAILURES, so each logs at warning, not info." {
    class: bad
  }

  no_signal: "NO Signal is constructed and NO POST is made.\nA bad context must never produce a signal, and a shorter prompt is\neven worse than a skip: a model handed fewer rows than its floor\nanswers with whatever it can still attend to, which is a confident\nnumber computed from too little (_context_for raises instead)." {
    class: bad
  }

  one_symbol: "one bad symbol does not stop the others\nthe try/except is per instrument inside tick(), not around the\nwhole pass — one illiquid scrip costs one Decision, not the minute" {
    class: py
  }

  tick -> outcomes: "per instrument"
  outcomes -> no_signal: "every failure outcome"
  tick -> one_symbol: "except Exception, contained"
  no_signal -> tick: "next symbol, same minute"
}

# ================================================================ BAND 4 ====
drop: "DROP AND COUNT — bounded queues, oldest-first eviction, never a block" {
  deliver: "Pipeline.deliver(tick, queue) — pipeline.go:589\nnon-blocking send, and on failure a non-blocking RECEIVE off the\nfront of queue, then a second non-blocking send.\nqueue is bidirectional because dropping the oldest tick is a receive.\nIt never blocks, and that is the whole point." {
    class: go
  }

  drop_oldest: "queue is full → the OLDEST queued tick is discarded\nand the NEWEST is admitted. tickBufferSize = 1024 per queue." {
    class: bad
  }

  why_drop: |md

    **Why not block.** The reader is the socket. A Kite reader that stops
    consuming stops answering the server's `ping` control frames, so the
    broker drops the session — a storage slowdown would escalate into a
    **reconnect storm**, which is strictly worse than losing a few ticks of
    a bar that is already stale.

    **Why the oldest.** The freshest tick is the one that matters: it sets
    the candle close the next inference pull will read. A queued tick cannot
    become more valuable with age.

  | { class: lib }

  drop_count: "mft_ingestion_ticks_dropped_total counts drop OPERATIONS,\nnot distinct lost ticks. There is a race window: between the two\nnon-blocking sends the single reader can drain the slot and refill it,\nso nothing was evicted, and the code increments anyway — the tick is\nlost either way and the counter says so. It is an upper bound on losses,\nnever a lower one. mft_ingestion_tick_queue_depth gauges the same path." {
    class: ctl
  }

  late: "mft_ingestion_ticks_late_total — a different drop, a different reason.\nfold() rejects a tick whose minute is at or before the symbol's\nwatermark (st.closed): a clock skew, a reordered frame, or a reconnect\nreplaying the tail of the session. Folding it would rebuild a bar that\nis already on disk and write it twice. The RAW TICK is still appended\nto the tick store, so nothing is lost from the tick store." {
    class: go
  }

  deliver -> drop_oldest: "select default"
  drop_oldest -> why_drop
  drop_oldest -> drop_count: "Inc()"
  drop_oldest -> late: "the raw append already happened"
}

# ================================================================ BAND 5 ====
surface: "SURFACE RATHER THAN SWALLOW — a failure reaches an operator" {
  writer_err: "storage.Writer.Err() → writer.err() → lastErr — writer.go:172, storage.go:238\nthe background flusher loop() records into lastErr and RETURNS NOTHING;\nErr is the only way to see a flush that failed off the caller's goroutine.\nflushLocked sets lastErr on the ctx-cancelled and writePartition paths,\nand clears it only after every partition landed." {
    class: bad
  }

  retain: "flushLocked retainUnwritten — writer.go:273\non failure the rows of partitions already written are dropped from the\nbuffer and the rest are kept in order, so the next flush retries exactly\nwhat is missing: no loss, no duplicate.\nwritePartition is .inflight-*.parquet → Sync → Close → rename to\npart-*.parquet → syncDir, so the final name never names a partial file." {
    class: store
  }

  readyz: "RegisterHealth adds a metrics.Checker named ingestion-storage\nwhose Check is Pipeline.Err() — pipeline.go:324, 333\nrecordError keeps only the FIRST failure; later ones are already in\nmft_ingestion_storage_append_errors_total by dataset and in the logs,\nand the first one explains the rest.\n/readyz answers 503 'degraded' instead of serving a healthy process that\nhas silently stopped storing. /healthz is liveness and stays green." {
    class: ctl
  }

  old_flush: "the previous flush() returned nothing and discarded ALL FOUR:\nos.MkdirAll, os.CreateTemp, the parquet row write, and the parquet\nfooter write. Commit message of core/storage, verbatim. Every one now\nreaches the caller wrapped with %w." {
    class: lib
  }

  writer_err -> readyz: "Pipeline.Err()"
  retain -> writer_err: "lastErr = err"
  writer_err -> readyz: "appendErrors.WithLabelValues(ticks|candles)"
  old_flush -> retain: "fixed by the rewrite"
}

# ================================================================ BAND 6 ====
refuse: "REFUSE TO START — a misconfiguration dies at boot, not silently in production" {
  metrics_listen: "core/metrics.Server OnStart — metrics.go:91\nln, err := net.Listen(tcp, srv.Addr) runs INSIDE the hook, BEFORE the\ngoroutine. A port already in use returns the error and fx aborts the\napplication. Binding inside the goroutine would log a failure beside a\nprocess that is up, green, and unscrapable." {
    class: bad
  }

  prefix_guard: "metrics.newSpec → must(panic) — naming.go:66, 91\nthree programmer errors stop the process at REGISTRATION: a name\nwithout the mandatory mft_ prefix (ErrMissingPrefix), an empty Help, or\na duplicate already on the registry.\nMetric construction is a programmer error, not a runtime condition —\na typo must not ship a series nobody is watching until 09:31 on a Monday." {
    class: bad
  }

  metrics_listen -> prefix_guard: "and the collectors are registered before Serve"
}

# ================================================================ BAND 7 ====
bounded: "BOUNDED LIFETIME — one-shot keys expire, and the boundary is load-bearing" {
  sweep: "fluxkv.Sweep(now) — fluxkv.go:120\ndrops every entry whose expiresAt has passed, returns the count.\nDriven by execution.StartCacheSweeper on a SweepInterval of 1 minute\nand logging only when n > 0.\nGet() ALREADY ignores an expired entry, so this is memory\nhousekeeping, not correctness: it exists so debounce windows and\nidempotency keys do not accumulate for the process lifetime." {
    class: lib
  }

  idem_ttl: "execution.idempotency_ttl_seconds, default IdempotencyTTL = 24h\nThe boundary is where exactly-once ENDS. cache.Get on 'IDEM:key'\nreplays to RISK_DUPLICATE and returns the original order id.\nA retry arriving after the TTL finds no entry, passes every risk check\nand places a SECOND order. The claim is only written after\nPlaceOrder succeeds — a failed placement claims nothing and must stay\nretryable — so the cache cannot close that window itself." {
    class: bad
  }

  sweep -> idem_ttl: "and reclaims the key"
}

# ================================================================ BAND 8 ====
stop: "SHUTDOWN — the order is fixed and each step depends on the last" {
  stop_order: "Pipeline.Stop(ctx) — pipeline.go:437\n1 cancel → core/broker's cancellable send unblocks and Stream returns\n2 wg.Wait, bounded by the fx stop deadline\n   (the supervisor is what closes upstream; closing it underneath a\n    streamer that is still sending would panic)\n3 relay drains upstream into queue, then closes queue\n4 processor drains queue and folds every tick it was handed\n5 sweep once more, so a bar that rolled over in the last seconds is not\n   lost to the sweep interval\n6 Flush (only while the deadline has time — Close flushes on a detached\n   context regardless), then Close both writers, then Err on both" {
    class: go
  }

  stop_err: "every step's error is recordError'd, not swallowed, and Stop\nreturns Pipeline.Err() so fx sees it.\nDrain timeout → 'ingestion: timed out draining N tick(s) after shutdown'\nplus ctx.Err(), where N = ticks.Pending() + candles.Pending(): a\nstreamer that ignores cancellation cannot be closed safely, so the\npipeline reports a timeout rather than panicking on a closed channel.\nIncomplete bars are DROPPED at shutdown on purpose — a short OHLCV is\nindistinguishable from a full one to the feature pipeline, and the raw\nticks they came from are already durable." {
    class: bad
  }

  stop_order -> stop_err: "Stop returns Err"
}

# ====================================================== THE COMPOUND PATH ====
compound: "END TO END — the failure that actually costs money.\n\n1  the Kite socket dies. Stream retries on its own backoff, forever, silently\n   apart from one Warn per attempt, and no tick reaches upstream.\n\n2  the supervisor is never entered: Stream does not RETURN, it loops. So\n   mft_ingestion_stream_restarts_total does NOT move — an outage that\n   looks like a healthy stream restart-free service.\n\n3  no tick → no candle completes → sweep finds nothing new → no\n   part-*.parquet is published. mft_ingestion_last_tick_age_seconds climbs,\n   on its own goroutine precisely so a wedged processor cannot freeze it.\n\n4  the inference loop keeps its one-minute cadence and reads the newest\n   candle that IS published. Once it is older than\n   staleness_guard = max(DEFAULT_MAX_CONTEXT_AGE 5m, flush_interval + 1m),\n   every minute returns STALE_CONTEXT.\n\n5  no signal, no order, no risk rejection. Every layer above did exactly\n   what it promises — retry, count, fail closed — and the platform simply\n   stops trading, loudly enough in the logs and in\n   mft_ingestion_last_tick_age_seconds to be noticed." {
  class: bad
}

# ---------------------------------------------------------------- edges ----
title -> retry
title -> fatal
title -> closed
title -> drop
title -> surface
title -> refuse
title -> bounded
title -> stop

kite -> retry.ws_dead: "socket" {style.stroke: "#90a4ae"}
kite -> fatal.is_fatal: "401 on the historical API" {style.stroke: "#90a4ae"}
kite -> retry.throttle: "429 on the historical API" {style.stroke: "#90a4ae"}

retry.ws_dead -> drop.deliver: "the reader is alive; it is the consumer that is not" {style.stroke: "#f9a825"; style.stroke-dash: 5}
drop.deliver -> surface.writer_err: "storage wedged → the queue fills" {style.stroke: "#f9a825"; style.stroke-dash: 5}
surface.writer_err -> retry.ws_dead: "and a wedged reader stops answering ping" {style.stroke: "#c62828"}

closed.no_signal -> bounded.idem_ttl: "so no key is ever written" {style.stroke: "#5e35b1"; style.stroke-dash: 5}
bounded.sweep -> stop.stop_order: "entries outlive nothing" {style.stroke: "#37474f"; style.stroke-dash: 5}
stop.stop_order -> surface.readyz: "Err() after Close" {style.stroke: "#37474f"; style.stroke-dash: 5}

retry.ws_dead -> compound: "step 1" {style.stroke: "#c62828"}
retry.stream_backoff -> compound: "step 2 — it never returns" {style.stroke: "#c62828"}
surface.writer_err -> compound: "step 3 — nothing published" {style.stroke: "#c62828"}
closed.outcomes -> compound: "step 4 — STALE_CONTEXT" {style.stroke: "#c62828"}

# --------------------------------------------------------------- footer ----
footer: "Derived from\n  core/broker/stream.go — Stream (62), session (127) with the pong deadline and\n    context.AfterFunc close, deliver (266), decodeTickFrame (280), backoffFor (325)\n  core/broker/kite.go — defaultReconnectBase 1s, defaultMaxBackoff 60s (34-35), maxBackoff\n    from broker.reconnect_max_backoff_seconds (141), reconnectBase never read from config (151)\n  core/broker/errors.go — ErrAuth, ErrRateLimit, ErrInstrumentNotFound, ErrUnavailable, ErrInvalidOrder\n  services/ingestion/pipeline.go — supervise (510), backoffFor (539), deliver (589), the two\n    non-blocking sends and the drop race (589-609), fold (655), Err (338), Check (333),\n    RegisterHealth (324), newMetrics (160), Stop (437), defaultReconnectBase/Max (96, 100), tickBufferSize (79)\n  core/storage/writer.go — loop (187), record (213), err (172), flushLocked (227),\n    retainUnwritten (273), writePartition (295)   ·   core/storage/storage.go — Err (238), Pending (241)\n  services/jobs/worker.go — isFatal (442), fetchSegment (340), runSymbol (278), RunBackfill (217),\n    maxAttempts (70), StartScheduler with cron.Recover (474)\n  services/jobs/backoff.go — Delay (37), FullJitter (72), base 500ms / max 30s (14-16)\n  services/jobs/errors.go — ErrNoHistory (19)\n  services/inference/app/loop.py — Outcome (121), _FAILURES (145), tick (293), evaluate (329),\n    _maybe_signal (451), _context_for (431), _staleness_of (555), staleness_guard (567),\n    DEFAULT_MAX_CONTEXT_AGE 5m (94), STALENESS_MARGIN 1m (100)   ·   runtime.py — max_context_age wiring (122)\n  services/execution/engine.go — execute (177), idempotencyTTL (42), IdempotencyTTL 24h (38),\n    SweepInterval 1m (52), StartCacheSweeper (251)\n  core/fluxkv/fluxkv.go — Set (85), Get (91), Sweep (120)\n  core/metrics/metrics.go — Server and the OnStart bind (82, 91)   ·   core/metrics/naming.go —\n    newSpec (66), must (91), ValidateName (33), Prefix mft_ (15)   ·   core/metrics/health.go — Checker (22)\n\nOne judgement call worth naming. Diagram 11 draws Stream's internal reconnect loop and the supervisor's\nloop as two layers, which can read as redundant. It is not: the broker loop absorbs every SESSION error\nand never returns, so the supervisor only fires for a pre-flight failure (ERR_AUTH, an unresolvable\ninstrument, a closed ctx). During a plain socket outage the supervisor is never reached, and\nmft_ingestion_stream_restarts_total stays flat — the outage is visible in mft_ingestion_last_tick_age_seconds\ninstead. Both behaviours are drawn above, in step 2 of the end-to-end path." { class: lib }