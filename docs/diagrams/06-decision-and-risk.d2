direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  go: {
    style.fill: "#e3f2fd"
    style.stroke: "#1976d2"
  }
  ctl: {
    style.fill: "#e5e7eb"
    style.stroke: "#37474f"
  }
  ext: {
    style.fill: "#eceff1"
    style.stroke: "#90a4ae"
  }
  core: {
    style.fill: "#e0f2f1"
    style.stroke: "#00897b"
  }
  mem: {
    style.fill: "#fff8e1"
    style.stroke: "#f9a825"
  }
  bad: {
    style.fill: "#ffebee"
    style.stroke: "#c62828"
  }
}

edge: "transport edge — services/execution/http.go" {
  req: "POST /v1/signals\nthe inference scheduler submits contracts.Signal —\neight fields, idempotency_key required" {
    class: ext
  }

  decode: "decodeJSON\nhttp.MaxBytesReader, maxRequestBody = 64 KiB\nDisallowUnknownFields()\na second JSON value is an error too" {
    class: go
  }

  wire: "normaliseSignal → ToUpper/TrimSpace\nvalidateSignal → symbol, side ∈ {BUY, SELL},\nprice > 0, idempotency_key non-empty" {
    class: go
  }

  unknown: "handleUnknown — the catch-all route\nknown path + wrong verb → 405 + Allow header\notherwise → 404" {
    class: go
  }

  edge_fault: "transport faults — a client bug, never a risk decision\nBAD_REQUEST 400 · PAYLOAD_TOO_LARGE 413\nMETHOD_NOT_ALLOWED 405 · NOT_FOUND 404\nINTERNAL_ERROR 500 (recoverPanic barrier)\n→ mft_execution_http_faults_total{code}\nRISK_* codes live in mft_execution_rejections_total,\nso a typo can never inflate a risk dashboard" {
    class: bad
  }

  req -> decode: "body"
  decode -> wire: "contracts.Signal"
  decode -> edge_fault: "unknown field, trailing\ncontent, > 64 KiB"
  wire -> edge_fault: "no symbol / side / price / key"
  unknown -> edge_fault
}

engine: "Engine.ExecuteSignal — services/execution/engine.go" {
  validate: "risk.ValidateSignal(sig)\nthe same wire rules, repeated on purpose — a request\nthat was never a decision has no reason code\nreturns a plain error, not a Rejection" {
    class: go
  }

  mu: "execute(ctx, sig, idemTTL) — e.mu.Lock() held\nfor the claim, the chain AND PlaceOrder" {
    class: go
  }

  idem: "fluxKV.Get(\"IDEM:\" + idempotency_key)\nexecution.idempotency_ttl_seconds = 86400\nset only after a fill" {
    class: mem
  }

  dup: "RISK_DUPLICATE → 409 Conflict,\ncarrying the order_id of the first attempt\nclaimed first, so a replay never reaches a check" {
    class: bad
  }

  chain: "contracts.Checks — Policy.New order (risk.go:109)" {
    c1: "1. MaxPositionCheck\n|quantity * price| ≤ pct% of Equity = Cash + RealisedPnL;\nBUY also ≤ Cash; equity ≤ 0 refuses; pct 0 = no cap\nRISK_MAX_POSITION"
    c2: "2. MaxPositionsCheck\nprospective positions ≤ max — counts the position the\nsignal would create, so a held symbol adds nothing\nRISK_MAX_POSITIONS"
    c3: "3. DrawdownCheck\n(PeakEquity − Equity) / PeakEquity ≤ pct;\npeak ≤ 0 refuses — an undefined limit is not a limit\nRISK_MAX_DRAWDOWN"
    c4: "4. DailyLossCheck\nRealisedPnL ≥ −limit; limit ≤ 0 is no daily cap —\nthe one execution key config.Validate\ndeliberately does not default\nRISK_DAILY_LOSS"
    c5: "5. DebounceCheck\nfluxKV key EXEC:<symbol>:<side> already armed?\nread-only: the engine arms it after a placement\nRISK_DEBOUNCED"
    c6: "6. QuantityCheck\n1 ≤ quantity ≤ max; quantity % lot_size == 0;\nSELL ≤ held — v1 is long-only, a short never prices\nRISK_BAD_QUANTITY"
    c7: "7. MarketHoursCheck\n09:15–15:30 IST inclusive, weekdays, not a holiday\nnil Calendar = every weekday trades\nRISK_MARKET_CLOSED"

    c1 -> c2: "execution.max_open_positions"
    c2 -> c3: "execution.max_drawdown_pct"
    c3 -> c4: "execution.daily_loss_limit"
    c4 -> c5: "execution.debounce_ttl_seconds"
    c5 -> c6: "execution.max_order_quantity"
    c6 -> c7: "execution.market_holidays\n(via NewStaticCalendar)"
  }

  rej: "risk rejection → 400 Bad Request\n{\"error\": \"RISK_*\", \"message\": …}\nclassify() passes a Rejection through verbatim\n→ mft_execution_rejections_total{reason}\nterminal: no broker call, no key claimed" {
    class: bad
  }

  place: "broker.Client.PlaceOrder(ctx, symbol, side, quantity, price)\nthe only way an order leaves the process" {
    class: go
  }

  broker_fault: "BROKER_UNAVAILABLE → 502 Bad Gateway\n→ mft_execution_orders_rejected_total\nnothing claimed, nothing debounced,\nso the same key still places on retry" {
    class: bad
  }

  claim: "fluxKV.Set, only after a fill:\nIDEM:<key> → order_id (idempotency_ttl_seconds)\nEXEC:<symbol>:<side> → order_id (debounce_ttl_seconds)" {
    class: mem
  }

  book: "risk.Book.Apply(sig) — fails closed\nBUY: free cash −= qty*price, cost reweighted\nSELL: entry cost returns to cash,\nrealisedPnL += (price − avg_cost) * qty\npeak equity updated; an Apply error is logged\nand the fill is kept, not dropped" {
    class: go
  }

  validate -> mu: "passes. A plain error here is not a Rejection,\nso classify() would label it BROKER_UNAVAILABLE 502 —\nunreachable from this route, which applied the same rules"
  mu -> idem: "1. claim"
  idem -> dup: "key present"
  idem -> chain: "2. run the chain\nBook.Snapshot() is the portfolio every check reads"
  chain -> rej: "first failure returns from Checks.Check;\nthe remaining checks never run"
  chain -> place: "3. all seven passed"
  place -> broker_fault: "error"
  place -> claim: "order_id"
  place -> book: "fill"
  chain.class: core
}

wire -> validate: "no risk budget is\ndecided at the edge"
dup -> resp_409: "409 {\"error\":\"RISK_DUPLICATE\",\n\"order_id\":\"4412\"}"

resp: "outcomeFor(orderTypeFor(\"\", price))\nLIMIT ⇒ 200 OK {\"order_id\",\"status\":\"OPEN\"}\nMARKET ⇒ 202 Accepted {\"status\":\"FILLED\"}\nlimits only — the transport cannot observe a fill" {
  class: ctl
}

resp_409: "409 Conflict\ncarries order_id — the one failure where\ninference needs it, to stop retrying" {
  class: ctl
}

unreachable: "202 FILLED is unreachable today.\nMaxPositionCheck sizes a position as quantity*price,\nso a zero-price market order is not small, it is\nunmeasurable: validateOrder and risk.ValidateSignal\nboth refuse it at the edge, and broker.Kite.placeOrder\nplaces MARKET at price 0. TestHandlerOrdersMarketOrderRefused\nrecords it as a test, not a comment." {
  class: ctl
  style.stroke-dash: 4
}

book -> resp: "mft_execution_orders_placed_total"
resp -> unreachable: "nothing reaches\nthis branch yet" {
  style.stroke-dash: 4
}

footer: "Derived from: services/execution/http.go · services/execution/engine.go · services/execution/risk/risk.go (Policy.New) · risk/checks.go · risk/market.go · risk/book.go · core/contracts/risk.go (Checks.Check) · core/contracts/contracts.go (Reason*) · core/config/config.go · docs/contracts.md §6 §7" {
  class: ctl
  style.fill: "#ffffff"
  style.stroke-dash: 4
}