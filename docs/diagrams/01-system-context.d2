# 01 · System context — who talks to MFT and why.
# External actors and external systems only, plus the platform as one box.
# Everything inside the platform box is a subject for a later diagram.
#
# Derived from: Plan.md §1 §3 §4 §5 §7, docs/contracts.md §7 §8,
# README.md, configs/config.example.yaml, Makefile, observability/README.md,
# core/broker/{kite,stream,orders,errors}.go, services/execution/engine.go,
# services/execution/risk/{risk,market}.go, services/jobs/{history,worker}.go,
# services/jobs/cmd/server/main.go, services/inference/app/{loop,config,candles}.py,
# services/inference/model/tabfm_model.py, observability/prometheus/prometheus.yml

direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  ext: {
    style.fill: "#eceff1"
    style.stroke: "#90a4ae"
  }
  go: {
    style.fill: "#e3f2fd"
    style.stroke: "#1976d2"
  }
  py: {
    style.fill: "#ede7f6"
    style.stroke: "#5e35b1"
  }
  core: {
    style.fill: "#e0f2f1"
    style.stroke: "#00897b"
  }
  store: {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
  }
  bad: {
    style.fill: "#ffebee"
    style.stroke: "#c62828"
  }
  note: {
    style.fill: "#e5e7eb"
    style.stroke: "#37474f"
  }
}

operator: "Operator / trader · one human, one local machine\n\nmake dev · make stop · make status\nmake backtest --synthetic --bars 2000\ngo run ./services/jobs/cmd/server -run-now\nthe mft-overview dashboard on :3000" {
  class: ext
}
operator -> platform: "runs all four processes; backtest and backfill run in the foreground"
operator -> cfg: "broker.api_key · api_secret · access_token"
operator -> grafana: "reads the dashboard"

cfg: "configs/config.yaml\nthe gitignored copy of configs/config.example.yaml\napp.timezone: Asia/Kolkata · inference.dry_run: true\nor KITE_API_KEY / KITE_API_SECRET / KITE_ACCESS_TOKEN in .env" {
  class: note
}
cfg -> platform: "MFT_CONFIG=configs/config.yaml\nMFT_METRICS_ADDR=:9090 / :9091 / :9092"

kite: "Zerodha Kite Connect" {
  class: ext
  k_ws: "WebSocket quote stream\nwss://ws.kite.trade"
  k_rest: "REST — https://api.kite.trade\nPOST /orders/regular\nGET /data/historical/..."
}
hf: "HuggingFace Hub\ngoogle/tabfm-1.0.0-pytorch — regression/model.safetensors\n~6.6 GB on first load, then ~/.cache/huggingface" {
  class: ext
  hf_licence: "'tabfm-non-commercial-v1.0'\nsource Apache-2.0, weights non-commercial and non-production\n→ research and backtest only; do not trade live on this score\nInferenceModel is the escape hatch" {
    class: bad
  }
}
prom: "Prometheus v3.0.1\nscrapes /metrics every 15s over host.docker.internal\n:9090 ingestion · :9091 execution · :9092 jobs" {
  class: ext
}
grafana: "Grafana 11.3.0 · 127.0.0.1:3000\ndatasource and dashboard provisioned from observability/grafana/" {
  class: ext
}
grafana -> prom: "queries it"

platform: "MFT platform — Plan.md\nfour processes over the shared core/ Go module (imported, never called over a network)\none machine · no message broker · no managed database" {
  style.bold: true
  style.stroke-dash: 3

  p_ingestion: "ingestion (Go)\nmetrics :9090" {
    class: go
  }
  p_jobs: "jobs (Go)\nmetrics :9092" {
    class: go
  }
  p_store: "data/ — durable, survives restart\ndata/ticks/ · data/candles/ · data/historical/\nDuckDB reads the Parquet tree directly;\nanalytics.duckdb_path is defaulted but unread" {
    class: store
  }
  p_inference: "inference (Python/FastAPI) :8000\nDuckDBCandleStore → TabFM → score in [-1, 1]\nno broker client exists in this process" {
    class: py
  }
  dry_run: "inference.dry_run: true\nthe default, and frozen\nthe scheduler scores, logs, and sends nothing" {
    class: bad
  }
  p_execution: "execution (Go)\nAPI :8080 · metrics :9091\nrisk gate → broker.Client.PlaceOrder" {
    class: go
    p_cal: "NSE calendar is local, not a service\nrisk.Calendar → risk.NewStaticCalendar(cfg.MarketHolidays...)\nexecution.market_holidays: [] means every weekday trades" {
      class: core
    }
    rejects: "fails closed — nothing reaches Kite\nRISK_MAX_POSITION · RISK_MAX_DRAWDOWN · RISK_DAILY_LOSS\nRISK_DEBOUNCED · RISK_DUPLICATE (409) · RISK_MARKET_CLOSED" {
      class: bad
    }
  }

  p_ingestion -> p_store: "Append(tick), 1-min rollup\nflush_interval_seconds: 300\nflush_max_rows: 10000 · partition_by: date"
  p_jobs -> p_store: "data/historical/symbol=<SYM>/from=<date>/to=<date>/candles.parquet\nan existing segment is skipped, so a run resumes"
  p_store -> p_inference: "DuckDB reads data/candles/ — pull, at each minute close\ninference.context_rows: 100 = TabFM max_num_rows"
  p_inference -> dry_run: "score ≥ inference.score_threshold: 0.55"
  dry_run -> p_execution: "only if dry_run were false:\nPOST /v1/signals → inference.execution_url"
}

p_ingestion -> k_ws: "Kite.Stream(ctx, symbols, ch)\nbackoff to reconnect_max_backoff_seconds: 60"
p_execution -> k_rest: "client.PlaceOrder(ctx, symbol, side, quantity, price)\nbroker.product: MIS → order_id back"
p_jobs -> k_rest: "GET /data/historical/…/{from}/{to}\n60-day segments · rate_limit_per_second: 3\n429 → broker.ErrRateLimit → backoff retry"
hf -> p_inference: "TabFMModel loads it on first use\nor point TABFM_CHECKPOINT_DIR at a local copy"
prom -> platform: "the inference job targets :8000 and stays DOWN —\nthat service registers no mft_ metrics yet"

footer: "Sources: Plan.md §1 §3 §4 §5 §7 · docs/contracts.md §7 §8 · README.md · configs/config.example.yaml · Makefile\nobservability/{README.md,prometheus/prometheus.yml} · core/broker/kite.go · services/execution/engine.go\nservices/execution/risk/market.go · services/jobs/{history.go,cmd/server/main.go} · services/inference/{app/loop.py,model/tabfm_model.py}" {
  shape: text
  style.font-size: 12
}
platform -> footer: "" {
  style.stroke-dash: 3
}