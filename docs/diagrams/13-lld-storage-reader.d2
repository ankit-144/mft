# 13 — LLD: the Parquet read side, and the DuckDB seam
# Question this diagram answers: how does a stored bar become contracts.Candle,
# and where exactly is the boundary at which DuckDB takes over from Go?
#
# Derived from core/storage/reader.go (read in full), core/analytics/analytics.go
# (read in full), core/storage/layout.go, core/storage/writer.go,
# services/inference/app/candles.py, docs/contracts.md §3, Plan.md §2.

direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  ext:   { style.fill: "#eceff1"; style.stroke: "#90a4ae" }
  go:    { style.fill: "#e3f2fd"; style.stroke: "#1976d2" }
  py:    { style.fill: "#ede7f6"; style.stroke: "#5e35b1" }
  lib:   { style.fill: "#e0f2f1"; style.stroke: "#00897b" }
  store: { style.fill: "#e8f5e9"; style.stroke: "#2e7d32" }
  mem:   { style.fill: "#fff8e1"; style.stroke: "#f9a825" }
  ctl:   { style.fill: "#e5e7eb"; style.stroke: "#37474f" }
  bad:   { style.fill: "#ffebee"; style.stroke: "#c62828" }
}

# ================================================================ callers ======
# Two readers, one directory tree, two engines. Nothing else crosses.

py_loop: "services/inference  (Python)\nInferenceLoop pulls on every minute close,\nTICK_PERIOD = 1m, via DuckDBCandleStore.tail(symbol,\ncontext_rows + WARMUP_ROWS) — never through the Go reader" { class: py }

go_caller: "Go, in-process\ncore/analytics.Store — narrow, typed,\nno query planner, no second copy of the data.\nHONEST NOTE: no production Go service wires this yet;\nthe only reference outside core is the compile-time\ncheck '_ Reader = (*CandleReader)(nil)' in storage.go:293.\nInference gets its bars from the Python side below." { class: ctl }

# ============================================ core/analytics — query helpers ====
c_go: "core/storage — the Reader, frozen in docs/contracts.md §3" {
  class: go

  a_ctor: "analytics.NewFromConfig(cfg) / New(root)\nstore owns exactly one *storage.CandleReader;\nStore.Reader() hands it back raw" { class: lib }

  a_ctx: "Store.Context(ctx, symbol, rows)\n'Returns the most recent rows for symbol ...\nthe exact shape the TabFM inference loop consumes'\nthin pass-through to CandleReader.Candles" { class: lib }

  a_helpers: |md
    **the helper layer over one primitive**

    `Summary(ctx, symbol, start, end)` — OHLC, VWAP,
    log-return volatility, MaxDrawdown

    `Returns(ctx, symbol, start, end)` — per-bar `Return`,
    first bar reported at zero, not dropped

    `Sessions(ctx, symbol, start, end)` — buckets by **UTC**,
    so this package needs no timezone dependency

    `Coverage(ctx, symbol)` — Bars / Days / First / Last,
    `Complete = Bars >= WarmupBars`, and
    `WarmupBars = 60` (docs/contracts.md §4)

    all four call `CandleRange(ctx, symbol, start, end, 0)`
  |

  a_win: "analytics.Window / Last(end, duration)\nWindow.Validate() rejects a non-increasing window.\nEmpty range is an ANSWER: Summary and Coverage return\na zero value and no error, never a fault" { class: mem }

  c_cfg: "NewCandleReaderFromConfig(cfg config.StorageConfig)\ndataDirFor(cfg, DatasetCandles)\n→ '<storage.data_dir>/candles', data_dir defaulting to 'data'" { class: go }

  c_root: "NewCandleReader(root)\nread-only by construction: it opens files,\nnever creates them.\nroot == '' → error" { class: go }

  iface: "type Reader interface  —  docs/contracts.md §3\n'Candles returns up to limit candles for symbol,\nascending by time.'\nThat is the whole contract: one method." { class: ctl }

  q_root: "Root() string\nthe dataset directory the reader scans" { class: go }

  q_candles: "Candles(ctx, symbol, limit)  []contracts.Candle\nlimit <= 0 → every candle stored for the symbol" { class: go }

  q_range: "CandleRange(ctx, symbol, start, end, limit)\nhalf-open [start, end); ascending; capped at limit rows\nlimit <= 0 → no cap. The query backtesting replays through" { class: go }

  q_files: "Files(ctx, symbol)  []string\nevery published parquet file, OLDEST FIRST:\nsort.Strings over date= partitions, then over\npart-<timestamp>.parquet names. This ordering is\nwhat makes 'later file wins' well-defined" { class: go }

  q_symbols: "Symbols(ctx)  []string\nevery 'symbol=' directory under the dataset root,\nunescapeHiveValue'd, sorted.\nThe one way to enumerate the dataset" { class: go }

  errmsg: |md
    **it fails closed, loudly, with context**

    `storage: symbol must not be empty`

    `storage: start ... must be before end ...`

    `storage: read symbol dir %s: %w`

    `storage: read parquet %s: %w`

    but `os.IsNotExist` → `nil, nil`: an unstreamed symbol
    is an ordinary state, not a fault
  | { class: bad }
}

# ================================================== scan and decode ==========
c_disk: "the store — hive-partitioned, immutable, and the only channel between services" {
  class: store

  symdir: "SymbolDir(root, symbol)\n'<root>/symbol=' + escapeHiveValue(symbol)\n'M&M' → 'symbol=M%26M'; a '/' or '=' would\nsilently relocate a dataset, so it is percent-encoded" { class: lib }

  fscan: "os.ReadDir(symDir) + filepath.Glob(dir, partGlob)\nno lock is taken and none is needed" { class: store }

  dates: "partitions: entries whose name starts with 'date=',\nTrimPrefix → sort.Strings → oldest day first" { class: store }

  pglob: "partGlob = 'part-*.parquet'\nthe whole safety argument in one constant" { class: store }

  inflight: "'.inflight-*.parquet'  —  writer.go inflightPrefix\nos.CreateTemp → parquet encode → file.Sync → os.Rename\nNo glob in Go or Python matches this name, so a reader\nrunning beside a flush can never observe a partial file.\nfreePartPath requires os.Lstat to miss: a closed file\nis never rewritten" { class: bad }

  layout: "data/candles/symbol=<SYMBOL>/date=<YYYY-MM-DD>/part-<timestamp>.parquet\ndata/ticks/... is written by the same Writer, and has\nNO reader — see the cost node below" { class: store }

  readall: "read(ctx, files)\nctx.Err() checked once per file, so a cancelled\ncaller aborts instead of decoding the whole history" { class: store }

  pqread: "readCandleFile(path) → parquet.ReadFile[Candle](path)\nparquet-go — pure Go, no cgo, whole-file decode" { class: lib }

  dedup: |md
    **later file wins** — reader.go:197, `read`

    files arrive in `Files()` order, and the map write is
    an UNCONDITIONAL overwrite:

    `byTS[row.Timestamp] = row.Contract()`

    so a re-flushed or backfilled bar supersedes the copy
    already in the map, and a timestamp is appended to
    `order` only the first time it is seen. One bar per
    minute, no matter how many segments overlap — this is
    what makes an idempotent backfill possible.

    the same rule in Python is
    `QUALIFY row_number() OVER (PARTITION BY timestamp
    ORDER BY filename DESC) = 1`
  | { class: mem }

  sortasc: "sort.Slice(order) → ascending by timestamp\nthen rebuild the slice from the map" { class: mem }

  tail_trim: |md
    **Judgement call: `limit` is a TAIL, not a head**

    `if limit > 0 && len(all) > limit { all = all[len(all)-limit:] }`

    docs/contracts.md §3 says only "up to limit candles" —
    it does not say which end. The reader returns the most
    recent, because inference wants recent bars and
    materialising years of history to keep the last 100
    would be absurd.

    `TestCandlesLimitReturnsTail` pins it: 20 bars,
    limit 5 → bars 15..19.
  | { class: mem }

  rng_filter: "for each candle: skip if Before(start) or not Before(end)\nbreak at len(out) == limit\nsorted input, so the break is safe" { class: mem }

  cost: |md
    **the known cost, stated honestly**

    `Candles` and `CandleRange` both call `Files()` then
    `read()` over EVERY file for the symbol and only then
    trim. A 100-bar pull is O(history) in decode.

    fine: years of 1-minute bars, a few hundred rows a minute

    not fine: the tick dataset. `DatasetTicks` is written
    but there is no `TickReader`, no `Ticks()` on `Reader`,
    and none planned — `CandleReader` is the only reader.

    the Python side is not O(history): DuckDB pushes the
    sort and limit into the file readers.
  | { class: mem }
}

# =================================================== the DuckDB seam =========
c_seam: "the seam — one tree, two engines, no daemon in between" {
  class: store

  glob: "CandleReader.Glob(symbol)\n'<root>/symbol=<ESCAPED>/date=*/part-*.parquet'\n'It is the path expression DuckDB consumes from the\nPython side, so a research query and the Go reader\naddress the same files.'\nIt is NOT 'date=' globbed with filepath — the\nsingle '*' is handed straight to read_parquet." { class: lib }

  pyglob: "symbol_glob(root, symbol)  —  candles.py:158\n'Mirrors CandleReader.Glob'.\nPython cannot call Go, so the expression is\nre-derived: PART_GLOB = 'part-*.parquet',\nescape_hive_value, candles_root(data_dir).\nCONTRADICTION, drawn not smoothed: two independent\ntests assert the same literal string — Go at\nstorage_test.go:880, Python at test_candles.py:240 —\nand NEITHER compares the two derivations. They agree\nby review, not by test." { class: py }

  scansql: |md
    **Go → DuckDB, as a string**

    `Store.ScanSQL(symbol)` returns

    `read_parquet('<CandleReader.Glob>', hive_partitioning=true)`

    so ad-hoc SQL goes through the writer's own layout
    code and cannot drift from the hive partitioning.

    note the framing differs from the Python tail query:
    `hive_partitioning=true` exposes symbol and date as
    columns, while `_TAIL_SQL` uses
    `hive_partitioning = false` plus `WHERE symbol = ?`.
    Same files, two framings, on purpose.
  | { class: lib }

  duckdb: "DuckDBCandleStore._tail_sync(symbol, limit)\nread_parquet(glob, hive_partitioning = false)\nWHERE symbol = ? ORDER BY timestamp DESC LIMIT scan,\nthen QUALIFY de-dupes, then ORDER BY timestamp ASC.\nlimit <= 0 → []\nread on one ThreadPoolExecutor(max_workers=1):\na duckdb connection is not safe for concurrent use" { class: py }

  oversamp: "_TAIL_OVERSAMPLE = 3\nscan = limit * 3 rows, because reproducing\n'later file wins' means seeing BOTH copies of a\nduplicated minute before de-duplicating.\nif the result still exceeds limit → candles[-limit:]" { class: mem }

  noglob: "the empty-store asymmetry — deliberate, both sides\nread_parquet RAISES on a glob matching nothing, so\n_tail_sync pre-checks globlib.glob(pattern) and returns []\nwith a debug log.\nGo Files()/Symbols() return nil, nil on os.IsNotExist.\nSame outcome, two different mechanisms" { class: bad }
}

# ================================================ the scoping decision ========
nogo: |md
  **SCOPING DECISION — do not "fix" this**

  `core/analytics` deliberately does **not** implement the
  `Engine` interface sketched in docs/contracts.md §3
  (`Query(...) (*duckdb.Rows, error)`). The DuckDB Go driver
  is a cgo binding, so implementing it would put a C++
  toolchain and a static libduckdb on every build host,
  break `CGO_ENABLED=0`, and contradict Plan.md §2's
  local-first single-binary goal.

  the platform already has DuckDB where it earns its keep:
  `services/inference/requirements.txt` declares `duckdb>=1.0`,
  and that process queries the same Parquet files — both
  sides address the store **by path**, not through a daemon.

  the split: **parquet-go** in Go for narrow, hot, typed reads;
  **DuckDB** in Python for wide, ad-hoc SQL — joins, window
  functions, anything this package cannot express — reached
  through `ScanSQL`. A future reader will be tempted to add the
  driver back. This node is the answer.

  `analytics.duckdb_path` and `analytics.read_only` are never
  contended here: the connection is in-memory, owned by the store.
| { class: bad }

# ---------------------------------------------------------------- edges ------
py_loop -> c_seam.duckdb: "await store.tail(symbol, context_rows + 60)" { style.stroke: "#5e35b1" }
c_seam.duckdb -> py_loop: "list[Candle], oldest first" { style.stroke: "#5e35b1" }
c_seam.duckdb -> c_seam.oversamp
go_caller -> c_go.a_ctor { style.stroke: "#37474f" }
c_go.a_ctor -> c_go.c_cfg: "NewCandleReaderFromConfig" { style.stroke: "#00897b" }
c_go.a_ctor -> c_go.a_ctx { style.stroke: "#00897b" }
c_go.a_ctor -> c_go.a_helpers { style.stroke: "#00897b" }
c_go.a_win -> c_go.a_helpers: "Window.Last(end, duration)" { style.stroke: "#f9a825" }
c_go.a_ctx -> c_go.q_candles: "s.reader.Candles(ctx, symbol, rows)" { style.stroke: "#00897b" }
c_go.a_helpers -> c_go.q_range: "CandleRange(ctx, symbol, start, end, 0)" { style.stroke: "#00897b" }
c_go.c_cfg -> c_go.c_root: "root == \"\" → error" { style.stroke: "#1976d2" }
c_go.c_root -> c_go.iface: "satisfies Reader" { style.stroke: "#1976d2" }
c_go.q_root -> c_go.c_root
c_go.q_symbols -> c_go.symdir: "shares SymbolDir + unescapeHiveValue" { style.stroke: "#1976d2" }

c_go.q_candles -> c_go.q_files: "Files(ctx, symbol)" { style.stroke: "#1976d2" }
c_go.q_range -> c_go.q_files { style.stroke: "#1976d2" }
c_go.q_files -> c_disk.symdir { style.stroke: "#2e7d32" }
c_disk.symdir -> c_disk.fscan { style.stroke: "#2e7d32" }
c_disk.fscan -> c_disk.dates { style.stroke: "#2e7d32" }
c_disk.dates -> c_disk.pglob { style.stroke: "#2e7d32" }
c_disk.fscan -> c_disk.pglob { style.stroke: "#2e7d32" }
c_disk.pglob -> c_disk.layout { style.stroke: "#2e7d32" }
c_disk.inflight -> c_disk.pglob: "renamed away — nothing globs a partial file" { style.stroke: "#c62828" }

c_disk.pglob -> c_disk.readall: "files, oldest first" { style.stroke: "#2e7d32" }
c_go.q_files -> c_disk.readall: "read(ctx, files)" { style.stroke: "#1976d2" }
c_disk.readall -> c_disk.pqread: "per file" { style.stroke: "#2e7d32" }
c_disk.pqread -> c_disk.dedup: "rows, in file order" { style.stroke: "#2e7d32" }
c_disk.dedup -> c_disk.sortasc { style.stroke: "#f9a825" }
c_disk.sortasc -> c_disk.tail_trim { style.stroke: "#f9a825" }
c_disk.sortasc -> c_disk.rng_filter { style.stroke: "#f9a825" }
c_disk.tail_trim -> c_go.q_candles: "the most recent limit" { style.stroke: "#f9a825" }
c_disk.rng_filter -> c_go.q_range: "start <= ts < end" { style.stroke: "#f9a825" }
c_disk.readall -> c_disk.cost { style.stroke: "#f9a825" }
c_disk.layout -> c_disk.cost: "1-minute bars only" { style.stroke: "#f9a825" }

c_go.q_candles -> c_go.errmsg: "symbol == \"\"" { style.stroke: "#c62828" }
c_go.q_range -> c_go.errmsg { style.stroke: "#c62828" }
c_go.q_files -> c_go.errmsg: "os.IsNotExist → nil, nil" { style.stroke: "#c62828" }
c_disk.pqread -> c_go.errmsg: "storage: read parquet %s: %w" { style.stroke: "#c62828" }

# the seam, end to end
c_disk.layout -> c_seam.glob: "the published files" { style.stroke: "#2e7d32" }
c_go.q_root -> c_seam.glob: "same root, same SymbolDir, same partGlob" { style.stroke: "#00897b" }
c_seam.glob -> c_seam.pyglob: "mirrored, not called — the drift risk lives on this arrow" { style.stroke: "#5e35b1"; style.stroke-dash: 3 }
c_go.q_candles -> c_seam.glob { style.stroke: "#00897b" }
c_seam.glob -> c_seam.scansql { style.stroke: "#00897b" }
c_seam.scansql -> c_seam.duckdb: "'make backtest' and research SQL" { style.stroke: "#5e35b1" }
c_seam.pyglob -> c_seam.duckdb: "_TAIL_SQL.format(glob=...)" { style.stroke: "#5e35b1" }
c_seam.duckdb -> c_seam.oversamp { style.stroke: "#f9a825" }
c_seam.duckdb -> c_seam.noglob: "glob matches nothing" { style.stroke: "#c62828" }
c_go.a_helpers -> c_seam.scansql: "anything needing joins or window functions goes out this way" { style.stroke: "#00897b" }

go_caller -> nogo: "Go reads Parquet with parquet-go, never DuckDB" { style.stroke: "#c62828" }
c_seam.duckdb -> nogo: "DuckDB lives in Python, where the dependency already exists" { style.stroke: "#c62828" }
nogo -> py_loop: "no cgo in the Go build" { style.stroke: "#c62828"; style.stroke-dash: 3 }

