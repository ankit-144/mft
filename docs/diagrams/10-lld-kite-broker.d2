direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  cls_ext:   { style.fill: "#eceff1"; style.stroke: "#90a4ae" }
  cls_go:    { style.fill: "#e3f2fd"; style.stroke: "#1976d2" }
  cls_lib:   { style.fill: "#e0f2f1"; style.stroke: "#00897b" }
  cls_mem:   { style.fill: "#fff8e1"; style.stroke: "#f9a825" }
  cls_plane: { style.fill: "#e5e7eb"; style.stroke: "#37474f" }
  cls_bad:   { style.fill: "#ffebee"; style.stroke: "#c62828" }
}

# ======================================================== construction ======
# fx binds core.NewKite, not broker.NewKite. That one-word difference is the
# integration fix: the bare constructor hands back a connector with no
# credentials, so every call under fx would fail checkAuth().
cfg: "config.BrokerConfig\nbroker.api_key · api_secret · access_token\nbroker.instruments · broker.product\nbroker.request_timeout_seconds\nbroker.reconnect_max_backoff_seconds" { class: cls_plane }

fxnew: |md
  **core.NewKite(cfg \*config.Config) — the integration fix**

  `core/fx.go` provides `core.NewKite`, never the bare
  `broker.NewKite`

  `broker.NewKite()` returns `newKite(&config.BrokerConfig{})`:
  no `access_token`, no watchlist, no product

  under fx every REST call then failed
  `checkAuth() → ErrAuth` and `Stream` subscribed to nothing
|
fxnew.class: cls_go

nkc: "broker.NewKiteFromConfig(cfg) (*Kite, error)\nfails only on values it cannot honour: negative\nrequest_timeout_seconds or reconnect_max_backoff_seconds\n→ ErrInvalidOrder. Missing credentials are NOT rejected here,\nso a service still starts in a credential-less dev environment" { class: cls_go }

nk: "broker.newKite(cfg) *Kite — unexported\nloggerPtr.Store(zap.NewNop()) first, so log() is never nil\nevery zero config value falls back to a constant:\ndefaultRequestTimeout 10s · defaultMaxBackoff 60s\ndefaultInstrumentTTL 1h · defaultProduct NRML\ndefaultPongTimeout 90s · defaultWriteWait 5s\ndefaultReconnectBase 1s · instrumentDumpMaxBytes 64 MiB" { class: cls_go }

ends: "type endpoints struct { httpBase, wsBase string }\nnot constants — a struct so tests point the connector\nat an httptest server\ninstrumentsURL() · ordersURL() · orderURL(id)\npositionsURL() · streamURL(token)" { class: cls_go }

sl: "Kite.SetLogger(l *zap.Logger)\nnil restores zap.NewNop()\nheld in loggerPtr atomic.Pointer[zap.Logger]\nbecause the read loop consults it on every reconnect\nand every unrecognised frame" { class: cls_go }

sp: "Kite.SetProduct(product string) error\nupper-cases, then checks validProducts\nMIS · CNC · NRML — anything else → ErrInvalidOrder" { class: cls_go }

prod: "Kite.product\nread under k.mu by placeOrder, written only by SetProduct\nNOTE: config.BrokerConfig.Product is never read by newKite" { class: cls_mem }

# ============================================================== wiring ======
streamer: "var _ Streamer = (*Kite)(nil)\nbroker.Streamer\nStream(ctx, symbols, out) error" { class: cls_lib }

clientif: "var _ Client = (*Kite)(nil)\nbroker.Client — the deprecated pre-contracts\nPlaceOrder(ctx, symbol, side, quantity, price)\nservices/execution/engine.go takes this surface" { class: cls_lib }

oc: "broker.NewOrderClient(kite) OrderClient\norderClient is the ONLY adapter in the package,\nand exists only because Client predates\ncontracts.OrderRequest" { class: cls_lib }

# ================================================================ wire ======
kc_do: "Kite.do(ctx, method, endpoint, form, maxBytes) ([]byte, error)\ncheckAuth() → ctx.Err() → http.NewRequestWithContext\nAuthorization: token <api_key>:<access_token>\nUser-Agent: mft-broker/1.0\na non-2xx is decoded into a kiteError so no caller ever\nsees an HTTP status code" { class: cls_plane }

kite_ext: "api.kite.trade · ws.kite.trade\nGET /instruments\nPOST /orders/regular\nDELETE /orders/regular/<order_id>\nGET /positions" { class: cls_ext }

# ================================================== the instrument master ===
instrs: "Kite.Instruments(ctx) ([]contracts.Instrument, error)\ncheckAuth(), then serve the cache while\ntime.Since(loadedAt) < instrumentTTL\nan empty watchlist returns nil, nil — not an error" { class: cls_go }

cache: "instrument []contracts.Instrument + loadedAt\ninstMu guards both — process-local, starts empty,\nso the first caller pays for the download\nwantedSymbols() upper-cases and dedups broker.instruments" { class: cls_mem }

dump: "GET /instruments → CSV with a header row\nread through io.LimitReader at\ninstrumentDumpMaxBytes = 64 MiB" { class: cls_ext }

parse: "parseInstrumentDump(body, want)\ncsv.Reader with FieldsPerRecord = -1\nrequires the instrument_token, exchange and tradingsymbol\ncolumns; a missing column → ErrUnavailable" { class: cls_go }

rank: "derivative(record) skips any row with a non-empty\noption_type or expiry — contracts.Instrument models a\ncash instrument and has nowhere to put a strike, so a\nF&O leg must not shadow the equity row\ninstrumentRank: NSE 0 · BSE 1 · NFO/CDS/MCX 2 · other 3" { class: cls_go }

parse2: "errNoToken(missing)\nerrNoToken: instrument dump has no cash instrument\nfor <symbols>: ErrInstrumentNotFound\nALL configured symbols resolve or the call fails —\na typo in broker.instruments is surfaced, not skipped.\nA row whose token or lot_size will not parse is skipped\nindividually and then surfaces here." { class: cls_bad }

instr1: "Kite.Instrument(ctx, symbol)\nthe single-symbol lookup: a linear scan over\nInstruments(ctx), so it shares the same cache and\nthe same all-or-nothing dump failure\nmiss → ErrInstrumentNotFound" { class: cls_go }

# =========================================================== order path =====
place: "Kite.PlaceOrder(ctx, symbol, side, quantity, price)\nprice > 0 → LIMIT, else MARKET, then\nplaceOrder(ctx, req, orderType)\nwhich is also what orderClient.PlaceOrder calls" { class: cls_go }

valid: "local validation in placeOrder, before any HTTP\nempty symbol · side not BUY or SELL · quantity <= 0 ·\nprice < 0 · MARKET carrying a price · LIMIT without one\nall of them → ErrInvalidOrder" { class: cls_bad }

instres: "placeOrder resolves Instrument(ctx, symbol) FIRST,\nso an unknown or misspelled symbol never reaches Kite\nthen: inst.LotSize > 1 and quantity % LotSize != 0\n→ ErrInvalidOrder" { class: cls_go }

form: "url.Values for POST /orders/regular\ntradingsymbol · exchange · direction · product\norder_type · quantity · variety=regular\nprice is set only for LIMIT\nread under k.mu, so a SetProduct is never seen\nhalf-applied to a form" { class: cls_go }

mapresp: "response mapping\njson.Unmarshal into status + order_id\nundecodable body → ErrUnavailable\nan empty order_id → ErrUnavailable\notherwise the broker order id is returned" { class: cls_go }

cancel: "Kite.CancelOrder(ctx, orderID)\nempty id → ErrOrderNotFound\nDELETE /orders/regular/<order_id>, 1 MiB body cap" { class: cls_go }

pos: "Kite.GetPositions(ctx)\ndecodePositions accepts a bare JSON array OR\n{ \"data\": [ ... ] } — both shapes Kite has used\nquantity is float64 on the wire and is narrowed to int\nnet as the broker reports it: negative is a short,\nzero is a squared-off day position" { class: cls_go }

# ======================================================= error mapping =====
non2xx: "resp.StatusCode outside 200..299 inside Kite.do" { class: cls_plane }

pke: "parseKiteError(status, body) → *kiteError\ndecodes {\"status\":\"error\",\"errors\":[{\"error_code\",\"message\"}]}\nor the legacy {\"error\":{\"code\",\"message\"}}\nfailing both, the first 200 bytes of the body become the message" { class: cls_go }

classify: "kiteError.Unwrap() → classifyStatus(status, code, message)\n401 or 403 → ErrAuth\n429, code \"429\", or 'too many request' → ErrRateLimit\n404 → ErrOrderNotFound\ninvalid_token · invalid_api_key · incorrect api_key ·\n'invalid access token' · 'session expired' → ErrAuth\n'instrument' · 'tradingsymbol' · 'unknown symbol' → ErrInstrumentNotFound\nstatus >= 500 → ErrUnavailable\n400, 405 or 409 → ErrInvalidOrder\nanything else → ErrUnavailable" { class: cls_go }

sentinels: "errors.Is on six sentinels — a switch on them is exhaustive\nErrAuth · ErrRateLimit · ErrInstrumentNotFound\nErrInvalidOrder · ErrOrderNotFound · ErrUnavailable" { class: cls_bad }

jobs: "services/jobs is the only caller that branches\nworker.go: errors.Is(err, ErrRateLimit) → throttles.Inc() and retries\nisFatal: ErrAuth or ErrInstrumentNotFound → stop the run for the symbol\nservices/execution/engine.go:202 does NOT branch: every\nPlaceOrder error is just e.rejected.Inc() plus a wrap" { class: cls_plane }

# ====================================================== instrumentation =====
deliv: "Delivered() int64 → delivered atomic.Int64\nincremented in deliver(ctx, out, tick) only after\n`out <- tick` actually handed the tick over" { class: cls_mem }

seq: |md
  `Sequence() uint64` → `seq atomic.Uint64`

  Kite's binary LTP frame carries no sequence number,
  so `deliver` stamps `k.seq.Add(1)` itself.

  **monotonic, and never reset by a reconnect** —
  `Stream`'s retry loop increments only `reconnects`.

  so a duplicated or reordered tick coming off a fresh
  socket is still detectable by comparing sequence
  numbers across the gap.
|
seq.class: cls_mem

reconn: "Reconnects() int64 → reconnects atomic.Int64\nk.reconnects.Add(1) once per retry in Stream\nbackoffFor doubles from defaultReconnectBase and\nsaturates at maxBackoff\n(a value that keeps climbing while ticks still arrive\nmeans a flapping socket)" { class: cls_mem }

resolver: |md
  **no adapter — a compile-time relationship**

  `services/jobs/interfaces.go`

  `InstrumentResolver interface { Instruments(ctx) ([]contracts.Instrument, error) }`

  `var _ InstrumentResolver = (*broker.Kite)(nil)`

  `services/jobs/worker.go` binds
  `func(k *broker.Kite) InstrumentResolver { return k }`
|
resolver.class: cls_lib

# ================================================================ edges =====
cfg -> nkc: "value" { style.stroke: "#37474f" }
fxnew -> nkc: "fx.Provide(NewKite)" { style.stroke: "#1976d2"; style.stroke-width: 3 }
nkc -> nk: "on success" { style.stroke: "#1976d2" }
nkc -> cfg: "negative seconds → ErrInvalidOrder" { style.stroke: "#c62828"; style.stroke-dash: 3 }
nk -> ends: "points at the real host" { style.stroke: "#90a4ae" }
nk -> prod: "defaultProduct NRML" { style.stroke: "#f9a825" }
sp -> prod: "MIS | CNC | NRML" { style.stroke: "#1976d2" }
sp -> sentinels: "unknown code → ErrInvalidOrder" { style.stroke: "#c62828"; style.stroke-dash: 3 }
sl -> reconn: "read on every reconnect" { style.stroke: "#1976d2" }
nk -> streamer { style.stroke: "#1976d2" }
nk -> clientif { style.stroke: "#1976d2" }
nk -> oc { style.stroke: "#1976d2" }

clientif -> place: "engine.go:202" { style.stroke: "#1976d2" }
oc -> place: "same placeOrder" { style.stroke: "#1976d2" }
place -> valid: "before any HTTP" { style.stroke: "#c62828" }
valid -> instres: "accepted" { style.stroke: "#1976d2" }
instres -> instr1: "lot size and token" { style.stroke: "#1976d2" }
instres -> form: "validated" { style.stroke: "#1976d2" }
form -> kc_do: "1 MiB cap" { style.stroke: "#1976d2" }
kc_do -> kite_ext: "authenticated REST call" { style.stroke: "#90a4ae" }
kc_do -> mapresp: "2xx body" { style.stroke: "#1976d2" }
mapresp -> kite_ext: "order_id" { style.stroke: "#90a4ae" }
cancel -> kc_do { style.stroke: "#1976d2" }
pos -> kc_do { style.stroke: "#1976d2" }
kc_do -> non2xx { style.stroke: "#c62828" }
non2xx -> pke { style.stroke: "#c62828" }
pke -> classify: "Unwrap" { style.stroke: "#c62828" }
classify -> sentinels: "one sentinel per call" { style.stroke: "#c62828" }
sentinels -> jobs: "errors.Is" { style.stroke: "#37474f" }
instrs -> sentinels: "ErrAuth when there is no token" { style.stroke: "#c62828"; style.stroke-dash: 3 }
cancel -> sentinels: "empty id → ErrOrderNotFound" { style.stroke: "#c62828"; style.stroke-dash: 3 }

instr1 -> instrs: "single symbol" { style.stroke: "#1976d2" }
instrs -> cache: "hit while inside instrumentTTL" { style.stroke: "#f9a825" }
instrs -> dump: "miss → wantedSymbols()" { style.stroke: "#90a4ae" }
instrs -> parse { style.stroke: "#1976d2" }
parse -> rank: "rows that parse" { style.stroke: "#1976d2" }
rank -> parse2: "unresolved symbols, sorted" { style.stroke: "#c62828" }
parse2 -> sentinels: "ErrInstrumentNotFound" { style.stroke: "#c62828" }
instrs -> resolver: "the one method" { style.stroke: "#00897b"; style.stroke-width: 3 }

streamer -> instrs: "resolves tokens before subscribing" { style.stroke: "#1976d2" }
streamer -> deliv: "68-byte binary LTP frame" { style.stroke: "#1976d2" }
deliv -> seq: "seq.Add(1)" { style.stroke: "#f9a825" }
deliv -> reconn: "socket died → retry loop" { style.stroke: "#f9a825" }

# =============================================================== footer =====
src: "Derived from\ncore/broker/kite.go (newKite, endpoints, SetLogger, SetProduct, do, Reconnects, Delivered, Sequence)\ncore/broker/instruments.go (Instruments, wantedSymbols, Instrument, parseInstrumentDump, derivative, instrumentFromRecord, instrumentRank)\ncore/broker/orders.go (PlaceOrder, placeOrder, CancelOrder, GetPositions, decodePositions)\ncore/broker/errors.go (six sentinels, kiteError.Unwrap, classifyStatus, parseKiteError)\ncore/broker/broker.go (Streamer, Client, OrderClient, NewOrderClient, errNoToken)\ncore/broker/stream.go (Stream, deliver, backoffFor)\ncore/fx.go (Module, NewKite) · core/config/config.go (BrokerConfig)\nservices/jobs/interfaces.go (InstrumentResolver) · services/jobs/worker.go (isFatal)\nservices/execution/engine.go (Engine.execute, line 202)" { class: cls_lib }