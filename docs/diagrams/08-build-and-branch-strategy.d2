# 08 - How ten components were built without conflicting.
#
# Engineering process, not runtime. Everything here is derived from the real
# git graph on integration/wave1, AGENTS.md, scripts/worktree.sh, the Makefile
# and the four go.mod files.

direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  trunk: {
    style.fill: "#e5e7eb"
    style.stroke: "#37474f"
    style.bold: true
  }
  shared: {
    style.fill: "#e0f2f1"
    style.stroke: "#00897b"
  }
  gopkg: {
    style.fill: "#e3f2fd"
    style.stroke: "#1976d2"
  }
  pypkg: {
    style.fill: "#ede7f6"
    style.stroke: "#5e35b1"
  }
  local: {
    style.fill: "#fff8e1"
    style.stroke: "#f9a825"
  }
  bad: {
    style.fill: "#ffebee"
    style.stroke: "#c62828"
  }
  step: {
    style.fill: "#e5e7eb"
    style.stroke: "#37474f"
  }
}

# ---------------------------------------------------------------- the trunk

master: "master  tip d33abd4\npush-protected: lock_branch, force pushes\nblocked, 1 approving review required,\nlinear history, enforce_admins.\nNothing merges here mid-flight" {
  class: bad
}

foundation: "foundation  (PR #1, tip 153091c)\nmaster + 1 commit. Exists only to absorb\nevery shared-file edit before the\ncomponent branches exist" {
  class: trunk
}

master -> foundation: "shared files land here FIRST,\nso no component PR ever touches one"

# -------------------------------------------------- what foundation holds

frozen: "frozen paths - no component may edit these (AGENTS.md)" {
  class: shared

  fd_docs: "docs/contracts.md\nfrozen interfaces, 18-column\nfeature schema, reason codes"
  fd_types: "core/contracts/\nTick, Candle, Signal,\nRejection"
  fd_cfg: "core/config/config.go\nevery key declared up front,\nincluding ones no service reads yet"
  fd_make: "Makefile\nall targets pre-declared"
  fd_gomod: "go.work + 4 x go.mod\n(core, ingestion, execution,\njobs) dependencies pre-resolved"
  fd_agents: "AGENTS.md + Plan.md\nthe ownership table lives here"
}

foundation -> frozen: "holds, verbatim"

# --------------------------------------------------- the mechanism, in order

mech: "the mechanism, in the order it happened" {
  class: trunk

  s1: "1 - declare the frozen paths\nAGENTS.md: Frozen files - do not edit"
  s2: "2 - give each component an\nexclusive path set, C1 to C10"
  s3: "3 - pre-resolve shared dependencies\ncore/tools.go pins gorilla/websocket via a\n//go:build tools blank import, so four\nmodules sharing core/go.mod never conflict.\nCommit d33abd4, on master before any fork" {
    class: shared
  }
  s4: "4 - build it in an isolated worktree\nscripts/worktree.sh add <name> feat/<name>" {
    class: local
  }

  gates: "checkpoint - green before the single commit" {
    class: local

    g_lint: "make lint\ngo vet ./... + gofmt -l .\nfails with 'gofmt needed:'"
    g_test: "make test\ngo test -race ./... per module.\n-race because ingestion's exactly-once\nbar completion and the risk engine's\nidempotency are concurrency claims"
    g_py: "make test-python\npytest app/tests + test_base.py +\ntest_heuristic_model.py ONLY, so the\ngate cannot load the 6.6GB TabFM\nweights on a 14GB box"
  }

  s5: "5 - one commit per component,\n'Wave 3: ingestion pipeline, ...'"
  s6: "6 - rebase onto the clean\nfoundation tip, then merge"

  s1 -> s2 -> s3 -> s4 -> gates -> s5 -> s6
}

foundation -> mech: "components branch from HERE, never from master"

# --------------------------------------------------- the ten feat branches

branches: "ten components, ten branches, ten open PRs - disjoint paths, so all ten merged with zero conflicts" {
  class: trunk

  b1: "C1  feat/kite-broker  PR #2\ncore/broker/**"
  b2: "C2  feat/storage-analytics  PR #5\ncore/storage/**, core/analytics/**"
  b3: "C3  feat/features  PR #9\ncore/features/**"
  b4: "C4  feat/ingestion  PR #10\nservices/ingestion/**"
  b5: "C5  feat/tabfm-model  PR #6\nservices/inference/model/**"
  b6: "C6  feat/risk-engine  PR #3\nservices/execution/risk/**, core/fluxkv/**"
  b7: "C7  feat/execution-api  PR #7\nservices/execution/http.go"
  b8: "C8  feat/jobs-backfill  PR #8\nservices/jobs/**"
  b9: "C9  feat/observability  PR #4\ncore/metrics/**, core/log/**, observability/**"
  b10: "C10  feat/inference-api  PR #11\nservices/inference/app/**"

  b1.class: gopkg
  b2.class: gopkg
  b3.class: gopkg
  b4.class: gopkg
  b5.class: pypkg
  b6.class: gopkg
  b7.class: gopkg
  b8.class: gopkg
  b9.class: gopkg
  b10.class: pypkg
}

mech.s6 -> branches: "each is independently mergeable"

# ------------------------------------------------------- worktree isolation

wt: ".worktrees/<name> - the isolation is the working tree,\nnot just the branch" {
  class: local

  wt1: ".worktrees/kite-broker\nindex and checkout of its own"
  wt2: ".worktrees/risk-engine\nindex and checkout of its own"
  wt_n: "scripts/worktree.sh remove --force\ndiscards uncommitted work in that\nworktree; the branch survives"
}

mech.s4 -> wt: "agents never share a checkout"

# ------------------------------------------------------------- integration

integ: "integration/wave1  (PR #13)\ncontinues test/integration, where C1, C6\nand C9 merged first, then C5, C2, C7, C8,\nC3, C4, C10" {
  class: trunk
}

branches -> integ: "merged one at a time"

# ------------------------------- found only by running the whole thing

fixes: "found only by running the whole thing - make dev, commit 3713734 and 7b8c268" {
  class: shared

  fx_kite: "core/fx.go bound broker.NewKite,\nthe zero-config constructor\n-> every fx-started service would have\nfailed to authenticate.\nbind broker.NewKiteFromConfig(cfg.Broker) instead" {
    class: bad
  }

  fx_metrics: "four execution counters predated\nC9's mft_ prefix rule, and\ncore/metrics must() panics at startup.\nrename them, or the guard fires on\nits own history" {
    class: bad
  }

  fx_cfg: "three config keys C1 and C6 needed\nwhile the schema was frozen:\nbroker.product (C1 defaulted NRML,\nwrong for intraday),\nexecution.idempotency_ttl_seconds (C6\nhardcoded 24h), execution.market_holidays" {
    class: shared
  }

  fx_graph: "services/jobs/worker.go: the fx module\nomitted four interface bindings, so\nthe constructors reported 'missing types'\nand the service exited before starting.\nThe -run-now path built the graph by hand,\nso every unit test still passed" {
    class: bad
  }
}

integ -> fixes: "these are not per-component bugs.\nNone of them was visible from inside\nits own worktree."

# ------------------------------------------------------------------ footer

footer: "Sources: AGENTS.md (frozen files, ownership, memory limit) - scripts/worktree.sh -\nMakefile targets test/lint/test-python - core/tools.go - go.work + 4 go.mod - core/fx.go -\ncore/metrics/naming.go - core/config/config.go - services/jobs/worker.go -\ngit log --all --graph and gh api branches/master/protection on integration/wave1.\nBranches, all real: master, foundation, feat/kite-broker, feat/storage-analytics, feat/features,\nfeat/ingestion, feat/tabfm-model, feat/risk-engine, feat/execution-api, feat/jobs-backfill,\nfeat/observability, feat/inference-api, integration/wave1 - plus feat/backtest (PR #12) and an\nunpushed feat/ingestion-pipeline. 13 PRs open, none merged: master is still at d33abd4." {
  class: shared
  style.font-size: 18
}