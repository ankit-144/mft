direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  py: {
    style.fill: "#ede7f6"
    style.stroke: "#5e35b1"
  }
  go: {
    style.fill: "#e3f2fd"
    style.stroke: "#1976d2"
  }
  lib: {
    style.fill: "#e0f2f1"
    style.stroke: "#00897b"
  }
  ctl: {
    style.fill: "#e5e7eb"
    style.stroke: "#37474f"
  }
  mem: {
    style.fill: "#fff8e1"
    style.stroke: "#f9a825"
  }
  ext: {
    style.fill: "#eceff1"
    style.stroke: "#90a4ae"
  }
  bad: {
    style.fill: "#ffebee"
    style.stroke: "#c62828"
  }
}

# ---------------------------------------------------------------------------
# One idempotency key, end to end. Derivation in Python, the wire in Go, the
# guarantee held by an in-memory map. No single component owns it, which is
# why the property is invisible from any one of them.
# ---------------------------------------------------------------------------

derive: "1 · Derivation — inference process, Python (C5/C10)" {
  class: py

  keyfn: "idempotency_key(symbol, side, as_of) — signals.py\nthe only function that mints a key. Deterministic in all three\narguments and in nothing else: no clock read, no uuid, no attempt counter,\nnothing time-varying." {
    class: py
  }

  fmt: "minute = as_of.astimezone(timezone.utc).strftime(KEY_MINUTE_FORMAT)\nKEY_MINUTE_FORMAT = \"%Y%m%dT%H%M\"\nthen f-string: symbol.strip().upper() : side.strip().upper() : minute\nUTC because that is what as_of already is on the wire, and it is the only\nrendering a local TZ cannot shift — two processes with different TZ agree." {
    class: py
  }

  keyshape: "<SYMBOL>:<SIDE>:<YYYYMMDDTHHMM>\nRELIANCE:BUY:20260929T1031\nThe example key of docs/contracts.md §7, so the format is the documented\none and not a private invention." {
    class: ctl
  }

  why: "Why exactly those three fields — each one is load-bearing\nsymbol + side + minute: two ticks over the same store produce ONE key, so a\ntimeout, a 502 or a mid-minute restart retries into the same claim.\nThe minute is in it: without it, the 409 would swallow every signal after the\nfirst and the strategy would place one order per day.\nThe side is in it: a BUY→SELL flip at the same minute close is a different\ndecision, and a 409 on it would suppress a genuine reversal." {
    class: ctl
  }

  fromscore: "Signal.from_score(...) sets idempotency_key once, at construction\nConfigDict(extra=\"forbid\"); the key is an ordinary field on contracts.Signal,\nnot a header. Nothing downstream re-derives it." {
    class: py
  }

  towire: "Signal.to_wire() → model_dump(mode=\"json\")\nEvery attempt re-sends the same dict, byte for byte. The key does not move\nbetween attempt 1 and attempt 3, which is the entire reason a retry is safe\nrather than merely a second order." {
    class: py
  }

  submit: "ExecutionClient.submit — execution.py\nDEFAULT_MAX_ATTEMPTS 3, exponential backoff with full jitter, capped at 4s.\nThe retry set is exactly: an httpx transport error, 429, or 5xx.\nA 400 is a decision and a 409 is a success — retrying either would only\nrepeat it or obscure it." {
    class: py
  }

  keyfn -> fmt
  fmt -> keyshape
  keyshape -> why: "the three-field\nderivation, defended"
  fromscore -> keyfn: "calls it once"
  fromscore -> towire
  towire -> submit: "same key, every attempt"
}

wire: "2 · Transport — execution process, Go (C7)" {
  class: ctl

  decode: "decodeJSON — strict, and strict is load-bearing here\nhttp.MaxBytesReader(w, r.Body, 64 KiB) · DisallowUnknownFields() · a second\nDecode that must return io.EOF\nThe whole point is that a mistyped key cannot pass as a good one." {
    class: go
  }

  typo: "idempotency_keey (typo) → sig.IdempotencyKey == \"\"\nThis is the silent collapse. encoding/json leaves the field at its zero value\nand reports nothing, so two genuinely different decisions — RELIANCE:BUY:…\nand TCS:BUY:… — would present as the same absent key, and distinct keys\nwould be collapsed by the code below rather than by a mistake in the client." {
    class: bad
  }

  norm: "normaliseSignal(&sig)\nToUpper + TrimSpace on symbol, side and idempotency_key — the one layer that\nbridges Kite's case-insensitive matching and the risk gate's exact comparison." {
    class: go
  }

  valsig: "validateSignal — the edge repeats the shape rules on purpose\nsymbol non-empty · side in BUY/SELL · price > 0 · idempotency_key non-empty\nMissing key → BAD_REQUEST 400, 'idempotency_key is required on\nPOST /v1/signals'. Refused here, before the lock and before the risk gate,\nbecause a request that was never a decision has no risk reason code." {
    class: bad
  }

  execsig: "Engine.ExecuteSignal(ctx, sig) (string, error)\nrisk.ValidateSignal(sig) runs first — shape only, in Go, no lock held.\nIt precedes the claim, and it claims nothing, so a retry re-validates and\nstill places. Then e.execute(ctx, sig, e.idemTTL)." {
    class: go
  }

  decode -> typo: "unknown field refused;\na known field misspelled\nis not"
  decode -> norm: "contracts.Signal"
  norm -> valsig
  valsig -> execsig: "a decision, not a typo"
  typo -> valsig: "caught here as 400,\nnot by the decoder"
}

engine: "3 · The claim — Engine.execute, one critical section (C6)" {
  class: go

  mu: "e.mu.Lock(); defer e.mu.Unlock() — the whole body\nThe claim, the risk chain, the broker call and the portfolio update are one\ncritical section. Without the lock a concurrent replay of one key can pass\nthe idempotency check and place a second order. At one signal per minute per\nsymbol the throughput cost is nil." {
    class: go
  }

  ns: "idempotencyKey(key) → \"IDEM:\" + key\nexecute() calls it at two separate places: the Get before the chain and the\nSet after the broker. An empty key returns empty, so the claim is skipped\nentirely — which is why the edge refuses to let one through." {
    class: mem
  }

  get: "e.cache.Get(\"IDEM:\" + sig.IdempotencyKey) → (v any, ok bool)\nfluxkv.Get returns ok=false for a missing entry AND for an expired one,\nand does not mutate on the read. The branch is therefore a single question." {
    class: mem
  }

  asym: "ok == true means exactly: a prior attempt of THIS KEY COMPLETED.\nThe asymmetry is the crux. It holds because the Set is written on the way out\nof the happy path — only after broker.Client.PlaceOrder returned a nil error —\nand not before it. So the key is evidence of a completed placement and never\nmerely of an attempt. Read up front, a claim-first design would record\nin-flight work and refuse a legitimate retry of a failed order." {
    class: mem
  }

  chain: "e.checks.Check(ctx, sig, e.book.Snapshot()) — all seven checks\nThe first failure returns its contracts.Rejection and the rest never run.\nStill inside the same lock, and still after the claim." {
    class: go
  }

  place: "broker.Client.PlaceOrder(ctx, symbol, side, quantity, price)\nThe only way an order leaves this process." {
    class: ext
  }

  set: "e.cache.Set(\"IDEM:\" + key, orderID, idemTTL)\nThe claim is written HERE, not at the top. A rejection and a broker failure\nboth leave this line unreached, which is the whole failure-path story." {
    class: mem
  }

  debset: "e.cache.Set(risk.DebounceKey(symbol, side), orderID, e.debounceTTL)\nEXEC:<symbol>:<side> — a different key space, a different purpose, a different\nTTL. Written on the same line as the IDEM Set, in the same store." {
    class: mem
  }

  book: "risk.Book.Apply(sig)\nA portfolio that cannot represent the fill is logged at Error and the fill is\nkept: the broker already filled it, so dropping it here would invent an\nexposure that is not the account." {
    class: go
  }

  mu -> ns
  ns -> get
  get -> asym
  asym -> chain: "ok == false — first\ntime this key"
  chain -> place: "every check passed"
  place -> set: "err == nil"
  set -> debset
  set -> book
  asym -> replay: "ok == true — replay"
  place -> failure: "err != nil"
}

replay: "4 · The replay — what the second attempt learns" {
  class: ctl

  dup: "RISK_DUPLICATE, with the stored orderID\ncontracts.Reject(ReasonDuplicate, 'idempotency key %q already processed\nas order %s'). Returned before any check and before the broker. Also\nincrements mft_execution_rejections_total — a replay IS counted as a\nrejection, and mft_execution_orders_rejected_total too." {
    class: bad
  }

  classify: "classify(err, orderID) — http.go\nerrors.As into *contracts.Rejection → surfaced verbatim, then\nout.orderID = orderID IF AND ONLY IF rejection.Code == ReasonDuplicate.\nOnly there does the order id carry information: on every other Rejection the\nengine returned \"\" alongside the error, so attaching it would be noise." {
    class: go
  }

  status: "statusForCode(contracts.ReasonDuplicate) → 409 Conflict\nEvery other risk reason and BAD_REQUEST fall to the default → 400.\n409 and not 400 is the semantic point: the key was honoured, not refused.\n400 would tell the client to stop retrying a decision it cannot change,\nand would mis-file a completed order as a bad request." {
    class: ctl
  }

  body: "errorResponse{ error=RISK_DUPLICATE, message=…, order_id=… }\norder_id is omitempty, so this is the only failure body in the API that\ncarries an order id." {
    class: ctl
  }

  ack: "submit() sees 409 → _ack_from(response, duplicate=True)\nSignalAck(order_id=…, duplicate=True, http_status=409)\nTreated as SUCCESS, not a failure. Inference cannot tell a lost response from\na lost request; calling this an error would log a phantom problem on every\nslow minute, and calling it a fresh fill would report an order placed minutes\nago." {
    class: py
  }

  loop: "loop.py: Decision(outcome=SENT, order_id=ack.order_id)\nThe key has done its job: the retry learns the order exists and stops.\nNo second POST, no second order." {
    class: py
  }

  dup -> classify
  classify -> status
  status -> body: "409"
  body -> ack: "back up the same\nPOST /v1/signals response"
  ack -> loop
}

failure: "5 · The failure — why a retry is safe, not just idempotent-on-success" {
  class: ctl

  placeerr: "broker.Client.PlaceOrder returns an error\nNothing is claimed and nothing is debounced: both Set lines are below the\nearly return, so the IDEM key and the EXEC key both stay unwritten." {
    class: bad
  }

  broke: "classify: not a *contracts.Rejection → BROKER_UNAVAILABLE\nstatusForCode(BROKER_UNAVAILABLE) → 502 Bad Gateway\nNot 400. By this point the request has passed every shape check, so the only\nwork left in the engine is the chain and the broker, and the chain reports as\na Rejection. 400 would tell inference to retry something that is not its\nfault." {
    class: bad
  }

  retrysafe: "httpx raised, 429, or 5xx → inside the retry set anyway\nAttempt 2 re-sends the same key. The claim lookup returns ok=false, so the\nchain runs again and the order still places. Retry-safety is the property\nthat matters; idempotent-on-success alone would strand a lost order forever." {
    class: py
  }

  placeerr -> broke
  broke -> retrysafe: "next attempt, same key"
}

ttl: "6 · TTL, and the limit it draws honestly" {
  class: ctl

  ttlcfg: "execution.idempotency_ttl_seconds, default 86400\ncore/config sets 0 → 86400; idempotencyTTL(cfg) falls back to the engine\nconstant IdempotencyTTL = 24h when the value is absent or non-positive.\nChosen to outlive inference's bounded retry loop, not the 5-minute debounce\nwindow. A trading day is 375 minutes, so a day-long key cannot expire inside\na session." {
    class: ctl
  }

  sweep: "StartCacheSweeper — every SweepInterval = 1 minute\nHousekeeping only, and the package doc says so: Get already reports an\nexpired entry as absent, so the sweeper reclaims memory, not correctness." {
    class: mem
  }

  limit: "The accepted limit: a retry arriving AFTER the TTL would place a\nsecond order. Get reports ok=false, the chain runs, PlaceOrder fills again\nand the position doubles. Nothing detects this.\nThis is a real and deliberate boundary, not an oversight — the guarantee is\n'exactly once within the key lifetime', and the lifetime is config, so an\noperator can shorten it to shrink the store at the cost of that guarantee.\nIt is also process-local: fluxKV is a per-process cache (Plan.md §4), so a\nrestart of the execution service forgets every claim, and inference's next\nminute is a fresh decision anyway." {
    class: bad
    style.stroke-dash: 4
  }

  ttlcfg -> limit
  sweep -> limit: "does not extend it"
}

contrast: "7 · Not the same thing as the debounce key" {
  class: ctl

  dbkey: "risk.DebounceKey(symbol, side) → \"EXEC:%s:%s\"\nEXEC:<symbol>:<side> — no minute, no quantity, no price, and no IDEM: prefix.\nThe prefix on the idempotency key is what makes the two spaces incapable of\ncolliding in one map." {
    class: mem
  }

  dbcheck: "DebounceCheck — INSIDE the risk chain\ne.checks.Check runs it, so a replayed IDEM key returns at the claim and never\nreaches it. The engine arms EXEC: only after a successful placement, so a\nrefused signal or a failed broker call never starts a window it cannot honour.\nRISK_DEBOUNCED → 400, not 409: the window is a policy refusal, not a replay." {
    class: go
  }

  dbpurpose: "Different questions entirely.\nDebounce is minimum SPACING between two DIFFERENT decisions about the same\nsymbol and side — 'do not trade RELIANCE BUY more often than every 300s'.\nIdempotency is the SAME decision arriving twice — 'this exact decision has\nalready been carried out, here is its order id'.\nSwapping them is a serious bug in both directions: a debounce TTL on the\nIDEM key would expire the exactly-once guarantee in 5 minutes, and an\nidempotency check on the debounce key would refuse a genuine second decision\nin the same minute and 409 it with an order id from an unrelated fill." {
    class: ctl
  }

  orderkey: "Engine.Execute (POST /v1/orders) shows the weaker half\nIt has no key field, so it derives ORDER:<symbol>:<side>:<qty>:<price> from the\norder's own content and stores it with e.debounceTTL, not e.idemTTL. An\nidentical order inside the debounce window is refused; the same order later\nin the day is allowed. Callers that can carry a key use ExecuteSignal." {
    class: go
  }

  dbkey -> dbcheck: "read by the chain"
  dbcheck -> dbpurpose
  dbkey -> dbpurpose
  orderkey -> dbpurpose: "the same store,\nthe shorter key"
}

wire -> engine: "Engine.ExecuteSignal,\nafter the edge checks"
engine -> replay: "ok == true"
engine -> failure: "err != nil"
failure -> submit: "attempt N+1,\nidentical body"
replay -> ttl: "a claim that outlives\nthe session"
engine -> contrast: "the same fluxKV map"
idempotency_key(namespace): "IDEM:"
idempotency_key -> ns: "prepended, never\npart of the Python key"

footer: "Derived from:\nservices/inference/app/signals.py (idempotency_key, KEY_MINUTE_FORMAT, Signal.from_score, to_wire)\nservices/inference/app/execution.py (ExecutionClient.submit, _ack_from, DEFAULT_MAX_ATTEMPTS, _MAX_BACKOFF_SECONDS)\nservices/inference/app/loop.py (submit call site, Decision.order_id)\nservices/execution/http.go (handleSignal, decodeJSON, decodeError, normaliseSignal, validateSignal, classify, statusForCode, writeError, errorResponse)\nservices/execution/engine.go (ExecuteSignal, Execute, execute, idempotencyKey, IdempotencyTTL, idempotencyTTL, SweepInterval, StartCacheSweeper)\nservices/execution/risk/checks.go (DebounceKey, DebounceCheck)\ncore/fluxkv/fluxkv.go (KV.Get, KV.Set, KV.Sweep) · core/contracts/contracts.go (Signal, ReasonDuplicate, Reject)\ncore/config/config.go (Execution.IdempotencyTTLSeconds, DebounceTTLSeconds) · configs/config.example.yaml\ndocs/contracts.md §1 §6 §7 · Plan.md §4" {
  class: ctl
  style.fill: "#ffffff"
  style.stroke-dash: 4
}
