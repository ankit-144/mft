direction: right

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

# --- classes: STYLE.md's colour vocabulary, no new colours ------------------
classes: {
  go-comp: Go branch {
    style.fill: "#e3f2fd"
    style.stroke: "#1976d2"
  }
  py-comp: Python branch {
    style.fill: "#ede7f6"
    style.stroke: "#5e35b1"
  }
  frz: Frozen file {
    style.fill: "#e0f2f1"
    style.stroke: "#00897b"
  }
  fdn: Foundation branch {
    style.fill: "#e5e7eb"
    style.stroke: "#37474f"
  }
  rpt: Reported, not edited {
    style.fill: "#ffebee"
    style.stroke: "#c62828"
  }
}

# --- column 1: the branch that owns every frozen file ----------------------
found: "branch 'foundation'\nowns and creates every teal box to the right\n\nd78cd3b  config schema, contracts,\nPlan.md, Makefile, docs/contracts.md\n877ab0a  contracts.Checker into core/contracts\nd33abd4  pre-resolve go.mod, go.sum,\nrequirements.txt\n\nEvery feat/* branch forks off this one,\nso no component branch ever has to touch\na shared file in order to unblock itself." {
  class: fdn
}

# --- column 1: the ten exclusive path sets (AGENTS.md, ownership table) -----
c1: "C1 kite-broker\ncore/broker/**\nKite.Stream(ctx, symbols)\nreads config, contracts" {
  class: go-comp
}
c2: "C2 storage-analytics\ncore/storage/**  core/analytics/**\nstorage.NewWriterFromConfig\nreads config, contracts, storage" {
  class: go-comp
}
c3: "C3 features\ncore/features/**\nfeatures.Build(candles) -> 18 cols\nreads contracts — and nothing else" {
  class: go-comp
}
c4: "C4 ingestion\nservices/ingestion/**\ningestion.Pipeline.Run(ctx)\nreads broker C1, storage C2,\nfluxkv C6, metrics C9" {
  class: go-comp
}
c5: "C5 tabfm-model\nservices/inference/model/**\nservices/inference/requirements*.txt\nTabFMModel, HeuristicModel\nreads docs/contracts.md §5" {
  class: py-comp
}
c6: "C6 risk-engine\nservices/execution/risk/**\nservices/execution/engine.go\ncore/fluxkv/**\nreads broker C1, metrics C9" {
  class: go-comp
}
c7: "C7 execution-api\nservices/execution/http.go\nthis one file, nothing else\nPOST /v1/signals, POST /v1/orders\ncalls engine.Place in C6" {
  class: go-comp
}
c8: "C8 jobs-backfill\nservices/jobs/**\njobs.Worker, resumable backfill\nreads broker C1, metrics C9" {
  class: go-comp
}
c9: "C9 observability\ncore/metrics/**  core/log/**\nobservability/**\nmetrics.Mux(cfg), mft_ prefix guard\nreads config" {
  class: go-comp
}
c10: "C10 inference-api\nservices/inference/app/**\nloop.py minute-close loop\nfrom model import InferenceModel (C5)\napp/features.py transcribed from C3" {
  class: py-comp
}

# --- column 2: what they asked for, and had to report ----------------------
r1: "broker.product\nasked for by C1, which defaulted\nto NRML — wrong for intraday\nlanded 3713734 on integration/wave1" {
  class: rpt
}
r2: "execution.idempotency_ttl_seconds\nexecution.market_holidays\nasked for by C6: the TTL was hardcoded\n24h, the calendar had no way in\nlanded 3713734 on integration/wave1" {
  class: rpt
}
r3: "core/fx.go\nDI root — NewStorageWriter,\nNewKiteFromConfig. OWNED BY NO COMPONENT\nand not on the frozen list either.\nC4 asked for the writer to read\nstorage.flush_interval_seconds.\nlanded 63999b3 on integration/wave1" {
  class: rpt
}

# --- column 3: frozen — imported by everyone, edited by no branch ----------
f_config: "core/config/config.go\nbroker.product\nstorage.flush_interval_seconds\nexecution.max_position_pct\ninference.dry_run" {
  class: frz
}
f_contracts: "core/contracts/\ncontracts.Tick, Candle, Signal\ncontracts.Portfolio\ncontracts.Checker\ncontracts.Reject(code, msg)" {
  class: frz
}
f_docs: "docs/contracts.md\n§4 the 18-column feature schema\n§5 the InferenceModel protocol\n§7 HTTP routes\n§8 'No component may add one'" {
  class: frz
}
f_make: "Makefile\nevery target pre-declared\nmake lint, make test" {
  class: frz
}
f_work: "go.work\nall five component modules\nlisted up front" {
  class: frz
}
f_mod: "go.mod, go.sum\nkiteconnect, parquet-go,\nprometheus — resolved once,\nbefore any branch forked" {
  class: frz
}

footer: "Sources — AGENTS.md 'Frozen files' and 'Ownership' tables (the source of truth for every box here);\nPlan.md §6 component matrix and 'Conflict avoidance rules' 1-5; docs/contracts.md §5, §6, §7, §8;\ncore/contracts/contracts.go, core/contracts/risk.go, core/config/config.go, core/fx.go, core/metrics/metrics.go;\ngit log d78cd3b, 877ab0a, d33abd4 (foundation), then 3713734 and 63999b3 (integration/wave1)." {
  class: fdn
}

# --- foundation created the frozen files and is the only thing that may ------
found -> f_config: "creates and owns"
found -> f_contracts: "creates and owns"
found -> f_docs
found -> f_make
found -> f_work
found -> f_mod

# --- each component reads the frozen files it depends on, and edits none ----
c1 -> f_config: "imports *config.Config"
c1 -> f_contracts: "contracts.Instrument"
c2 -> f_config: "storage.flush_interval_seconds"
c2 -> f_contracts: "contracts.Candle, contracts.Tick"
c3 -> f_contracts: "contracts.Candle — its only import"
c4 -> f_config: "broker.instruments, storage.data_dir"
c4 -> f_contracts: "contracts.Tick"
c5 -> f_docs: "§5 InferenceModel, FEATURE_COLUMNS"
c6 -> f_config: "execution.max_position_pct, execution.debounce_ttl_seconds"
c6 -> f_contracts: "contracts.Checker, contracts.Portfolio"
c7 -> f_contracts: "contracts.Signal, contracts.Rejection"
c8 -> f_config: "jobs.schedule, broker.instruments"
c8 -> f_contracts: "contracts.Candle"
c9 -> f_config: "metrics.addr, app.log_level"
c10 -> f_docs: "§4 feature schema, §7 three endpoints"
c10 -> f_config: "reads the same YAML — inference.dry_run"

# --- reported changes: they stopped at the boundary, and landed upstream ----
c1 -> r1: "needed a key the schema\ndid not declare"
c6 -> r2: "needed a key the schema\ndid not declare"
c4 -> r3: "needed a wiring change\nit had no claim to"
r1 -> f_config: "merged, not requested"
r2 -> f_config: "merged, not requested"