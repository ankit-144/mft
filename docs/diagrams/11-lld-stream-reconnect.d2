direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  ext: {style.fill: "#eceff1"; style.stroke: "#90a4ae"}
  go: {style.fill: "#e3f2fd"; style.stroke: "#1976d2"}
  lib: {style.fill: "#e0f2f1"; style.stroke: "#00897b"}
  mem: {style.fill: "#fff8e1"; style.stroke: "#f9a825"}
  ctl: {style.fill: "#e5e7eb"; style.stroke: "#37474f"}
  bad: {style.fill: "#ffebee"; style.stroke: "#c62828"}
}

title: "core/broker — Kite.Stream as a state machine.\nThe socket is the volatile thing; Stream never hands it back while ctx is live." {
  style.bold: true
  style.font-size: 20
}

# ---------------------------------------------------------- layer 1: session ----
pre: "PRE-FLIGHT   Kite.Stream(ctx, symbols, out)\ncheckAuth -> ERR_AUTH, Instruments(ctx),\nlookupToken -> ERR_INSTRUMENT_NOT_FOUND\nsubs built once; any failure here RETURNS" { class: go }

dial: "Kite.dial(ctx)\nDialContext to wss://ws.kite.trade\nHandshakeTimeout = request_timeout_seconds" { class: go }

subs: "subscribe, then mode = full\nwriteJSON under writeMu,\nwriteWait 5s deadline" { class: go }

liveness: "LIVENESS\nSetPongHandler, SetPingHandler\npongTimeout 90s, refreshed on EVERY read" { class: mem }

pump: "session() read loop\nconn.ReadMessage()\nno goroutine is spawned here" { class: go }

text: "text frame -> wsPing\nwsAction(a[0]) == \"ping\"\npongReply() echoes the timestamp" { class: go }

decode: "decodeTickFrame(frame, symbolByToken)\nbinary LTP only\nunsubscribed token -> skip, not fatal" { class: go }

layout: |md

  **the 68-byte LTP frame** — `tickFrameLen = 8 + 60`

  `0` instrument_token uint32 → `Tick.Token`

  `4` exchange_timestamp uint32 → `Tick.Timestamp`

  `8` last_price float64 → `Tick.Price`

  `16` last_quantity · `20..52` ohlc[4] — **not read**

  `52` **total_traded_volume** int64 → `Tick.Volume`

  `60` total_traded_quantity — **not read**

| { class: lib }

deliver: "deliver(ctx, out, tick)\nselect on out and ctx.Done\nseq.Add(1) · delivered.Add(1)" { class: go }

consumer: "upstream chan broker.Tick, cap 1024\nPipeline.relay → process → candle store" { class: mem }

dead: "DEAD SOCKET\n90s with no read → ReadMessage errors\nwrapped ERR_UNAVAILABLE" { class: bad }

backoff: "backoffFor(attempt, base, max) — stream.go:325\ndelay = base, then for i < attempt:\n  if delay >= max return max, else delay *= 2\nfinal guard: delay > max OR delay <= 0 returns max\nbase = defaultReconnectBase 1s, a constant, not a config key\nmax = broker.reconnect_max_backoff_seconds, default 60\n1s → 2s → 4s → 8s → 16s → 32s → 60s → 60s …  attempt 6 on is flat\niterative doubling, never a shift: 63 shifts overflow\n  int64 negative, and a negative timer fires at\n  once — an outage becomes a hot reconnect loop\non the way out: reconnects.Add(1), a Warn\n  \"kite stream reconnecting\", time.NewTimer(delay)" { class: bad }

shutdown: "shutdown   context.AfterFunc(ctx, conn.Close)\nread unblocks at once instead of\nwaiting out the 90s deadline" { class: ctl }

seq: "Kite.Sequence() — monotonic\nseq, reconnects, delivered live on the\nKite struct, so they survive a re-dial" { class: mem }

ext_kite: "KITE  wss://ws.kite.trade\nbinary LTP frames, text control frames" { class: ext }

# --------------------------------------------------------- layer 2: the seam ----
ret: "Stream RETURNS\npre-flight failures only, or ctx.Err()\nsession errors are retried forever inside" { class: bad }

call: "Pipeline.supervise(ctx, upstream)\nre-invokes Stream on its own backoff,\ndefer close(upstream) makes the drain safe" { class: go }

sup_back: "Pipeline.backoffFor(attempt)\ndefaultReconnectBase 1s → defaultReconnectMax 60s,\ndoubling, saturating, same iterative reason" { class: ctl }

gap: "why there are two layers\nevery SESSION error — dial, subscribe, read,\npong — is swallowed by the loop and retried\nforever; sessionErr reaches only zap.Error\nunsupervised, a return left the process\nup, /healthz green, and storing nothing:\nan outage with no log line and no metric" { class: bad }

# ------------------------------------------------------------------------ edges ----
title -> pre
ext_kite -> dial: "handshake"

pre -> dial: "for { attempt := 0 }"
dial -> subs: "conn, err == nil"
subs -> liveness: "armed before the first read"
subs -> pump: "kite stream subscribed"
pump -> text: "text frame"
pump -> decode: "BinaryMessage"
liveness -> pump: "refreshed on every read" {style.stroke-dash: 4; style.stroke: "#f9a825"}
decode -> layout: "one 68-byte frame"
decode -> deliver: "Tick{Symbol, Token, Price, Volume, Timestamp}"
text -> subs: "pong, under writeMu" {style.stroke-dash: 4}
deliver -> consumer: "out <- tick"

liveness -> dead: "no read for 90s" {style.stroke: "#c62828"}
pump -> dead: "error, ctx still live"
dead -> backoff: "session returns"
backoff -> dial: "timer fires, attempt++"
backoff -> shutdown: "ctx.Done() → return ctx.Err()" {style.stroke-dash: 4; style.stroke: "#c62828"}
deliver -> seq

pre -> ret: "return, not retry" {style.stroke: "#c62828"}
ret -> gap: "and nobody was watching" {style.stroke: "#c62828"}
gap -> sup_back: "broker stream returned, restarting"
sup_back -> call: "p.wait(ctx, delay)"
call -> pre: "re-invoked, pre-flight again" {style.stroke: "#37474f"; style.stroke-dash: 5}
shutdown -> call: "ctx.Err() → supervise returns too" {style.stroke: "#37474f"; style.stroke-dash: 5}

# ------------------------------------------------------------------------ footer ----
footer: "Derived from\n  core/broker/stream.go — Stream (62), session (127), dial (221), wsAction (242), pongReply (252),\n    deliver (266), decodeTickFrame (280), encodeTickFrame (307), backoffFor (325), tickFrameLen + off* (27-37),\n    wsCommand / wsPing (41-52)\n  core/broker/kite.go — defaultPongTimeout 90s, defaultWriteWait 5s, defaultReconnectBase 1s,\n    defaultMaxBackoff 60s (30-38), assigned at 151-154; maxBackoff from reconnect_max_backoff_seconds (141);\n    streamURL (68), Reconnects (188), Delivered (191), Sequence (197)\n  core/broker/broker.go — Streamer (27), Tick = contracts.Tick (21)   ·   errors.go — the four sentinels\n  services/ingestion/pipeline.go — supervise (510), backoffFor (539), wait (558), defaultReconnectBase 1s\n    and defaultReconnectMax 60s (96, 100), Start (374), Stop (437)\n  core/config/config.go — broker.reconnect_max_backoff_seconds, default 60 (49, 143)\nJudgement call, documented at stream.go:293: Volume is taken from total_traded_volume at offset 52 and\ntotal_traded_quantity at offset 60 is dropped. Kite sends both; for NSE equity they are equal, and both are\ncumulative day figures rather than per-tick deltas, so the frame is forwarded as-is and the consumer aggregates." { class: lib }