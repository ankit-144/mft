# 02 · Container view — what runs where, and what each process links.
#
# One question: four deployable processes, their entrypoints and HTTP surfaces,
# and which core/ library each one actually imports. Every edge below is an
# import in a non-test Go file, or a type in an fx.Provide/fx.Invoke
# signature. The two `bad` nodes are real findings, not decoration.
#
# Derived from: core/fx.go, core/config/config.go, core/metrics/{metrics,health}.go,
# services/ingestion/cmd/server/main.go, services/ingestion/{pipeline,candles}.go,
# services/execution/cmd/server/main.go, services/execution/engine.go,
# services/execution/http.go, services/execution/risk/,
# services/jobs/cmd/server/main.go, services/jobs/{worker,store}.go,
# services/inference/Dockerfile, services/inference/app/{main,runtime}.py,
# services/inference/model/base.py, Makefile (make dev), go.work
#
# The two unwired claims were checked with:
#   grep -rl 'mft/core/features'  --include='*.go' .  -> no hits
#   grep -rl 'mft/core/analytics' --include='*.go' .  -> no hits

direction: right

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  go: {
    style.fill: "#e3f2fd"
    style.stroke: "#1976d2"
  }
  py: {
    style.fill: "#ede7f6"
    style.stroke: "#5e35b1"
  }
  lib: {
    style.fill: "#e0f2f1"
    style.stroke: "#00897b"
  }
  ext: {
    style.fill: "#eceff1"
    style.stroke: "#90a4ae"
  }
  store: {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
  }
  ctl: {
    style.fill: "#e5e7eb"
    style.stroke: "#37474f"
  }
  bad: {
    style.fill: "#ffebee"
    style.stroke: "#c62828"
  }
  note: {
    style.fill: "#eceff1"
    style.stroke: "#90a4ae"
    style.font-size: 14
  }
}

# --- the four deployable containers ---------------------------------------

ingestion: "Service 1 · ingestion (Go)" {
  class: go
  direction: down

  ing_main: "cmd/server/main.go\nfx.New(core.Module,\ningestion.Module).Run()"
  ing_surf: "no application HTTP surface\nGET /metrics · GET /healthz · GET /readyz\non MFT_METRICS_ADDR=:9090 via metrics.Mux\nRegisterHealth adds 'ingestion-storage'"
  ing_mod: "ingestion.Module\nfx.Provide NewCandleStore, NewPipeline\nfx.Invoke AttachBrokerLogger,\nRegisterHealth, (*Pipeline).Run"
}

execution: "Service 3 · execution (Go)" {
  class: go
  direction: down

  exe_main: "cmd/server/main.go\nfx.New(core.Module,\nexecution.Module).Run()"
  exe_api: "execution.addr = :8080\nPOST /v1/signals · POST /v1/orders\nGET /v1/portfolio · GET /v1/health\ncatch-all / → handleUnknown"
  exe_surf: "GET /metrics · GET /healthz · GET /readyz\non MFT_METRICS_ADDR=:9091"
  exe_mod: "execution.Module\nfx.Provide NewEngine\nfx.Invoke StartHTTPServer,\nRegisterEngine, StartCacheSweeper"
  exe_risk: "services/execution/risk\nrisk.FromConfig(cfg.Execution)\nDrawdownCheck, DailyLossCheck\nreject with contracts.ReasonMaxDrawdown\n'RISK_MAX_DRAWDOWN', contracts.ReasonDailyLoss"
}

jobs: "Service 4 · jobs (Go)" {
  class: go
  direction: down

  job_main: "cmd/server/main.go\nfx.New(core.Module, jobs.Module).Run()\n-run-now: hand-built graph, never binds\n:9092, exits 1 on failure"
  job_surf: "no application HTTP surface\nGET /metrics · GET /healthz · GET /readyz\non MFT_METRICS_ADDR=:9092"
  job_mod: "jobs.Module\nfx.Provide NewLimiterFromConfig,\nNewParquetStoreFromConfig, NewScheduler,\nNewBackfillWorker, NewKiteHistory\nfx.Invoke StartScheduler"
}

inference: "Service 2 · inference (Python)" {
  class: py
  direction: down

  inf_main: "uvicorn app.main:app --port 8000\nservices/inference/Dockerfile\nbuild_runtime(config) → Runtime"
  inf_api: "inference.addr = :8000\nGET /healthz · GET /v1/context · POST /v1/predict\ninference.dry_run defaults true"
  inf_runtime: "Runtime{config, store, predictor, sender, scheduler}\nDuckDBCandleStore(candles_root(...))\nExecutionClient(inference.execution_url)\nmodel/ registry: heuristic always,\ntabfm only if the backend imports"
}

# --- the shared core module ------------------------------------------------
#
# Teal = core/. Not wrapped in a container: dagre drops a container whose
# children are also edge endpoints from the outside, and the nine packages are
# the endpoint of nearly every edge in this diagram.

core_module: "core/ — github.com/mft/core\ncore.Module (core/fx.go)\nfx.Provide ConfigPath, config.Load, log.New,\nmetrics.Registry, metrics.Handler, fluxkv.New,\nNewStorageWriter, NewKite, NewOrderClient,\n*broker.Kite→broker.Streamer, →broker.Client\nfx.Invoke metrics.Server"
core_module.class: lib

lib_broker: "core/broker\nbroker.Streamer, broker.Client,\nbroker.OrderClient, *broker.Kite"
lib_config: "core/config\nConfigPath, config.Load\nMFT_METRICS_ADDR overrides metrics.addr"
lib_contracts: "core/contracts\nfrozen shared domain types"
lib_fluxkv: "core/fluxkv\nfluxkv.New → *fluxkv.KV\nTTL map, per-process only"
lib_storage: "core/storage\n*storage.Writer\n*storage.CandleWriter"
lib_metrics: "core/metrics\nRegistry, Handler, Mux,\nDefaultChecks, Server"
lib_log: "core/log\nlog.New → *zap.Logger\nlog.Middleware, log.WithContext"
lib_features: "core/features\nfeatures.Builder, NewBuilder"
lib_analytics: "core/analytics\nanalytics.Store, NewFromConfig"

lib_broker.class: lib
lib_config.class: lib
lib_contracts.class: lib
lib_fluxkv.class: lib
lib_storage.class: lib
lib_metrics.class: lib
lib_log.class: lib
lib_features.class: lib
lib_analytics.class: lib

parquet: "data/ Parquet cold store — source of truth\ndata/ticks/ · data/candles/ · data/historical/\nsame files, addressed by path from Go and from Python"
parquet.class: store

kite: "Zerodha Kite Connect\nWS ticks in · REST orders out"
kite.class: ext

bad_port: "metrics.Server listens inside fx OnStart, not in a goroutine.\nA busy :9090 fails startup outright instead of leaving a\nprocess that looks healthy but cannot be scraped — this is\nwhy make dev separates all three with MFT_METRICS_ADDR."
bad_port.class: bad

bad_unwired: "core/features and core/analytics have no Go importer\nanywhere in the repo. Inference builds its table with\napp/features.py instead — a second implementation of the\nfrozen 18-column schema. Green, and linked by nothing."
bad_unwired.class: bad

note_fx: "core.Module also provides *storage.Writer to all three Go graphs and\nnothing in execution or jobs consumes it; jobs never consumes fluxkv.New\neither — fx is lazy, so an unconsumed provider is never constructed. Neither\nimports core/storage at all: jobs writes Parquet with parquet-go directly in\nservices/jobs/store.go."
note_fx.class: note

footer: "Sources: core/fx.go · core/config/config.go · core/metrics/metrics.go ·\ncore/metrics/health.go · services/ingestion/cmd/server/main.go ·\nservices/ingestion/pipeline.go · services/ingestion/candles.go ·\nservices/execution/cmd/server/main.go · services/execution/engine.go ·\nservices/execution/http.go · services/execution/risk/ ·\nservices/jobs/cmd/server/main.go · services/jobs/worker.go ·\nservices/jobs/store.go · services/inference/Dockerfile ·\nservices/inference/app/main.py · services/inference/app/runtime.py ·\nservices/inference/model/base.py · Makefile · go.work"
footer.class: note

# --- edges ----------------------------------------------------------------
#
# Container-level on purpose: an edge says "this process imports this package",
# and the symbol that proves it is on the label. Core edges leave the service
# container rather than its ingestion.Module child, because a child node that
# is an endpoint both inside and outside a container cannot be ranked.

ingestion -> core_module: "fx.New(core.Module,\ningestion.Module).Run()"
execution -> core_module: "fx.New(core.Module,\nexecution.Module).Run()"
jobs -> core_module: "fx.New(core.Module,\njobs.Module).Run()"

ingestion -> lib_broker: "broker.Streamer"
ingestion -> lib_fluxkv: "*fluxkv.KV\ncandle map"
ingestion -> lib_storage: "*storage.Writer\n*storage.CandleWriter"
ingestion -> lib_contracts
ingestion -> lib_config
ingestion -> lib_metrics: "DefaultChecks()"

execution -> lib_broker: "broker.Client\nbroker.OrderClient"
execution -> lib_fluxkv: "debounce\n+ idem keys"
execution -> lib_contracts: "OrderRequest\nPosition"
execution -> lib_log: "log.Middleware"
execution -> lib_config
execution -> lib_metrics

jobs -> lib_broker: "*broker.Kite → InstrumentResolver\ninstrument token only, never an order"
jobs -> lib_contracts
jobs -> lib_log: "cmd/server/main.go\n(runOnce path)"
jobs -> lib_config
jobs -> lib_metrics: "Registry()"

core_module -> bad_port: "metrics.Server\nfx.Invoke"
lib_features -> bad_unwired: "no importer" {style.stroke-dash: 3}
lib_analytics -> bad_unwired: "no importer" {style.stroke-dash: 3}

ingestion -> parquet: "append tick + closed candle"
jobs -> parquet: "writes data/historical/ with\nparquet-go, not core/storage"
inference -> parquet: "DuckDB SELECT over\n<data_dir>/candles"
inference -> execution: "POST /v1/signals\ninference.execution_url"
execution -> kite: "PlaceOrder / CancelOrder"