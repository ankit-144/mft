direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  py: {
    style.fill: "#ede7f6"
    style.stroke: "#5e35b1"
  }
  store: {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"
  }
  lib: {
    style.fill: "#e0f2f1"
    style.stroke: "#00897b"
  }
  mem: {
    style.fill: "#fff8e1"
    style.stroke: "#f9a825"
  }
  go: {
    style.fill: "#e3f2fd"
    style.stroke: "#1976d2"
  }
  ctl: {
    style.fill: "#e5e7eb"
    style.stroke: "#37474f"
  }
  bad: {
    style.fill: "#ffebee"
    style.stroke: "#c62828"
  }
}

cfg: "inference.instruments — the entire work list\ninference.context_rows 100 · horizon_bars 1\nscore_threshold 0.55 · order_quantity 10\nexecution_url · dry_run true (the default)" {
  class: ctl
}

wiring: "build_runtime(config) — runtime.py:88\nstore = DuckDBCandleStore(candles_root(storage.data_dir))\npredictor = Predictor.from_name(inference.model)\nsender = ExecutionClient(inference.execution_url)\nmax_context_age = staleness_guard(storage.flush_interval_seconds)\nWired once, so a research run and a live run differ only in dry_run." {
  class: ctl
}

run: "MinuteScheduler.run(stop) — loop.py:251\nFires forever until cancelled or stop is set. Not an HTTP\nendpoint: docs/contracts.md §7 fixes the production path as an\ninternal scheduler on each minute close." {
  class: py
}

boundary: "_seconds_to_next_boundary() — loop.py:277\nnext = (ts // 60 + 1) * 60, the same UTC grid the candle\ntimestamps are truncated to, so ticks do not drift: a pass\nthat takes four seconds still starts on the next minute.\nFloored at min(MIN_SLEEP_SECONDS 0.5, period / 10) so an\noverrun cannot spin against the boundary it just missed." {
  class: py
}

tick: "tick() -> list[Decision] — loop.py:293\nTicks and last_tick advance before any work. One Decision per\ninstrument, in configured order. Never raises." {
  class: py
}

iso: "per-symbol isolation — the try/except around every evaluate()\nA single symbol's fault is recorded and the loop moves to the\nnext instrument: one broker hiccup must not silence the other\ninstruments for the rest of the session." {
  class: py
}

eval: "evaluate(symbol) -> Decision — loop.py:329\nReturns rather than raises for every expected failure. This is\nthe fail-closed property: a Decision is the only exit from this\nfunction, and no path escapes it." {
  class: py
}

guard: "staleness_guard(flush_interval_seconds) — loop.py:567\nmax(DEFAULT_MAX_CONTEXT_AGE 5m, flush + STALENESS_MARGIN 1m)\nat storage.flush_interval_seconds 300 -> max(5m, 300s + 1m) = 6m\n\nThe reason is real. C2 writes .inflight-*.parquet and renames it\ninto the part-*.parquet glob only at flush, so a store working\nperfectly still reports a context up to one flush interval old.\nA guard tighter than that would skip every minute of a healthy\nsystem. Derived from the flush interval rather than guessed, so\na 30-second deployment does not also have to shorten the guard." {
  class: ctl
}

skips: "Outcome.is_failure — six reasons. Every one is one symbol\nskipped and logged, never the loop and never another symbol." {
  class: bad

  notloaded: "NOT_LOADED\npredictor.is_loaded() is false.\nno signal is built on a guess." {
    class: bad
  }

  noctx: "NO_CONTEXT\nno candles stored for this symbol.\nAn unstreamed instrument yields [], not an error." {
    class: bad
  }

  stale: "STALE_CONTEXT\n_staleness_of(candles[-1].timestamp):\nage = now(UTC) - newest candle, > max_context_age.\nA context that has not advanced while the loop has run\nis a stalled store or a dead feed, not a market." {
    class: bad
  }

  badctx: "BAD_CONTEXT\nFeatureBuilder.build raised FeatureError, or the warmed\nwindow is under the model's floor, or C5 raised\nInvalidContextError. Never a repaired table, never a\nshortened prompt." {
    class: bad
  }

  err: "ERROR\nThe candle read failed, or the model raised something other\nthan InvalidContextError. tick() records the same Outcome\nfor an exception that escaped evaluate() altogether." {
    class: bad
  }

  sendfail: "SEND_FAILED\nExecutionError after the client's bounded attempts. Logged\nwith its idempotency key so the next minute's state can be\nreconciled. Not retried here: a decision that outlives its\nminute is a decision made on a stale context." {
    class: bad
  }
}

pull: "the pull — CandleStore.tail into the Parquet cold store" {
  class: store

  sizing: "wanted = min(inference.context_rows, MAX_CONTEXT_ROWS)\n= min(100, 100) = 100\nCapped before the warm-up margin is added, so a context_rows\nlarger than TabFM can attend to costs nothing at the store." {
    class: py
  }

  store: "CandleStore.tail(symbol, wanted + WARMUP_ROWS)\n= tail(symbol, 100 + 60) = tail(symbol, 160)" {
    class: store
  }

  duck: "DuckDBCandleStore._tail_sync, on a 1-worker thread\nrun_in_executor: a DuckDB call is synchronous C++ and would\nstall the same loop that serves the debug endpoints." {
    class: store
  }

  glob: "symbol_glob() -> root/symbol=RELIANCE/date=*/part-*.parquet\nMirrors storage.CandleReader.Glob, so the Go reader and this\none address the same files. Never .inflight-*: that is the whole\nreason pull beats push here. glob() matching nothing returns\n[], because read_parquet raises on an empty file set and an\nunstreamed symbol is an ordinary state, not a fault." {
    class: store
  }

  sql: "_TAIL_SQL\nread_parquet(glob, hive_partitioning = false)\nORDER BY timestamp DESC LIMIT 160 * _TAIL_OVERSAMPLE 3 = 480\nQUALIFY row_number() OVER (PARTITION BY timestamp\nORDER BY filename DESC) = 1 — later file wins, as in Go —\nthen ORDER BY timestamp ASC.\nThe oversample exists so a backfill and a live flush covering the\nsame minute can both be seen before de-duplication." {
    class: store
  }

  candles: "list[Candle] oldest first, at most 160.\n480 raw rows scanned, 160 distinct minutes survive, 60 are\ndropped as warm-up, 100 reach the prompt." {
    class: store
  }

  sizing -> store
  store -> duck
  duck -> glob
  glob -> sql: "files match"
  sql -> candles: "deduped, ascending"
}

builder: "FeatureBuilder.build(candles) — features.py:181\nPure: no clock, no I/O, no randomness, every timestamp taken\nfrom the candles handed in. One row per candle, the frozen\n18-column order, builder shared by every symbol." {
  class: py
}

warmup: "FeatureTable.context(wanted) — features.py:121\n160 fetched - WARMUP_ROWS 60 dropped = 100 warmed rows,\nand len(100) > rows(100) is false so no further trim.\nDropped, not zero-padded: a warm-up row of mostly zeros reads\nto the model as a real market in which nothing moved." {
  class: lib
}

short: "_context_for: FeatureError when len(context) <\nmax(MIN_CONTEXT_ROWS 60 + horizon, horizon + 1)\nat horizon_bars 1 that is max(61, 2) = 61 warmed rows.\nA short prompt is refused, never shortened: a model handed\nfewer rows than its floor answers with whatever it can still\nattend to, which is a confident number from too little." {
  class: bad
}

predict: "Predictor.predict(context, horizon)\none worker thread, max_workers=1. The model is neither async\nnor reentrant and TabFM's prompt table is mutable, and\nPOST /v1/predict reaches the same instance, so predictions\nare serialised. At three instruments a minute that costs nothing." {
  class: py
}

thr: "abs(score) < inference.score_threshold\nscore_threshold 0.55" {
  class: py
}

below: "BELOW_THRESHOLD\n|score| < threshold. A skip, not a failure:\n_log at debug, because the model answered." {
  class: ctl
}

side: "side_for_score(score) — signals.py:55\nscore > 0 -> BUY · score < 0 -> SELL" {
  class: lib
}

nodir: "NO_DIRECTION\nside_for_score raises ValueError for score 0.0, a non-finite\nprediction, or anything outside [-1, 1]. Refused rather than\ncoerced into a buy, where it would trade the neutral answer." {
  class: ctl
}

signal: "Signal.from_score(...) — signals.py:161\npydantic BaseModel, extra=forbid, mirroring contracts.Signal.\nField names are the JSON keys, so model_dump() is the body C7 expects.\n\nprice = candles[-1].close — the close of the LAST candle in the\ncontext. It is the reference price the risk gate sizes against\nand execution reports, NOT the predicted value: a score in\n[-1, 1] is not a price, and the frozen 18-column schema carries\nno close.\nas_of = table.as_of — the minute close being predicted from." {
  class: py
}

key: "idempotency_key = <SYMBOL>:<SIDE>:<YYYYMMDDTHHMM>\ne.g. RELIANCE:BUY:20260929T1031 — the example key in\ndocs/contracts.md §7, so the format is the documented one.\n\nDeterministic in exactly three fields: symbol, side, and the\nminute close. Nothing time-varying, nothing random, nothing\nper-attempt. A timeout or a mid-minute restart re-sends the SAME\nkey, so the retry is not a second order; the next minute close\nproduces a different one, so C7's 409 does not swallow the\nstrategy's every signal after the first. The side is in the key,\nso a BUY/SELL flip at the same minute close is a new decision\nrather than a suppressed reversal.\n\nThe minute is rendered from UTC as_of via %Y%m%dT%H%M. TZ\ncannot shift it: two processes with different TZ still agree.\nThis is the load-bearing field — it is what makes the\nexecution side's 409-on-duplicate mean anything at all." {
  class: mem
}

dryrun: "inference.dry_run — default true\nWhen true the signal is built and logged in full, key and\nwire body both, and nothing leaves this process. It does not\nskip scoring: a research run leaves a decision record that can\nbe diffed against a live one." {
  class: ctl
}

client: "ExecutionClient.submit(signal) — execution.py:142\ntimeout 5.0s · max_attempts 3 · backoff 0.25s doubled, full\njitter, capped at 4.0s. Every attempt re-sends the body byte for\nbyte, which is what makes the retries safe.\nRetried: transport error, 429, 5xx. Returned or raised at once:\n4xx, because a 400 is a decision and saying it again changes\nnothing; and 409, because a 409 is a success — the order exists\nand the response carries its order_id." {
  class: py
}

post: "POST /v1/signals\n202 filled · 200 working · 400 refused by risk\n409 replayed idempotency_key + the original order_id" {
  class: ctl
}

exec: "C7 execution-api — the only edge out of this process.\nhandleSignal decodes into contracts.Signal, takes the\nRISK_DUPLICATE 409 under the same lock that places the order." {
  class: go
}

sent: "SENT — outcome=SENT\ndetail = str(SignalAck) · order_id = getattr(ack, order_id)\nA 409 is reported as duplicate=True, not as a failure: a\nlost response is indistinguishable from a lost request." {
  class: mem
}

decision: "Decision(symbol, outcome, detail, score, signal, order_id,\ncandidates, as_of) — frozen, slots, one per instrument per\nminute. The outcome is a str Enum so it logs as a readable\nword and compares equal to a metric label." {
  class: py
}

api: "main.py — the debug surface, NOT the production path\nGET  /healthz    -> status ok, model_loaded, model, dry_run, instruments\nGET  /v1/context -> last N feature rows, warmed and trimmed exactly\n                    as the loop does, so a reader sees what the model saw\nPOST /v1/predict -> symbol, score, model, as_of — and nothing else\n\nNeither debugging endpoint places an order and neither can lower\ninference.dry_run: a debugging curl must not become a trade.\n503 MODEL_NOT_LOADED · 404 NO_CONTEXT · 422 BAD_CONTEXT ·\n502 STORE_UNAVAILABLE" {
  class: ctl
}

cfg -> wiring: "frozen inference section"
wiring -> run: "asyncio.create_task(scheduler.run(stop),\nname = minute-scheduler)"
run -> boundary: "each pass"
boundary -> tick: "delay elapsed"
tick -> iso: "for symbol in self.instruments"
iso -> eval: "await evaluate(symbol)"
iso -> err: "except Exception ->\nOutcome.ERROR, one symbol only"

eval -> notloaded: "predictor.is_loaded() is false"
eval -> pull: "in order, top to bottom"

candles -> noctx: "not candles"
candles -> stale: "candles[-1].timestamp"
candles -> builder: "candles"
builder -> badctx: "FeatureError"
builder -> warmup: "FeatureTable"
warmup -> short: "shorter than the floor"
short -> badctx: "FeatureError"
warmup -> predict: "context, horizon_bars"
predict -> badctx: "InvalidContextError"
predict -> err: "any other exception"
predict -> thr: "score in [-1, 1]"
thr -> below: "no"
thr -> side: "yes"
side -> nodir: "ValueError"
guard -> stale: "max_context_age = 6m at flush 300s"

side -> signal: "score, and candles[-1].close\nas the reference price"
signal -> key
key -> dryrun: "inference.dry_run is false"
dryrun -> client: "otherwise"
client -> sendfail: "ExecutionError after 3 attempts"
client -> post: "signal.to_wire()"
post -> exec: "202 / 200 / 409 duplicate"
exec -> sent

below -> decision
nodir -> decision
sent -> decision
skips -> decision: "recorded and logged,\nnever raised"

decision -> api: "the loop is the product;\nthis is the debugging surface"

footer: "Derived from:\nservices/inference/app/loop.py (MinuteScheduler, run, _seconds_to_next_boundary, tick, evaluate,\n_context_for, _maybe_signal, _staleness_of, Decision, Outcome, staleness_guard, TICK_PERIOD,\nMIN_SLEEP_SECONDS, DEFAULT_MAX_CONTEXT_AGE, STALENESS_MARGIN, SignalSender)\nservices/inference/app/candles.py (CandleStore, DuckDBCandleStore, _tail_sync, _TAIL_SQL, symbol_glob,\nPART_GLOB, _TAIL_OVERSAMPLE, Candle)\nservices/inference/app/signals.py (Signal, Signal.from_score, side_for_score, idempotency_key,\nKEY_MINUTE_FORMAT, rfc3339) · services/inference/app/execution.py (ExecutionClient, submit,\nSignalAck, DEFAULT_TIMEOUT_SECONDS, DEFAULT_MAX_ATTEMPTS, DEFAULT_BACKOFF_SECONDS)\nservices/inference/app/features.py (FeatureBuilder.build, FeatureTable.context, WARMUP_ROWS,\nFeatureError) · services/inference/app/predictor.py (Predictor.predict, load) · app/runtime.py\n(build_runtime, Runtime.startup) · app/main.py (create_app, /healthz, /v1/context, /v1/predict)\ncore/config/config.go (inference.*, storage.flush_interval_seconds) · core/storage/reader.go\n(CandleReader.Glob) · docs/contracts.md §1, §7" {
  class: ctl
  style.fill: "#ffffff"
  style.stroke-dash: 4
}