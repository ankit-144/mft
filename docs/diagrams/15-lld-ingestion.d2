direction: down

vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
    pad: 40
  }
}

classes: {
  ext:   {style.fill: "#eceff1"; style.stroke: "#90a4ae"}
  go:    {style.fill: "#e3f2fd"; style.stroke: "#1976d2"}
  py:    {style.fill: "#ede7f6"; style.stroke: "#5e35b1"}
  lib:   {style.fill: "#e0f2f1"; style.stroke: "#00897b"}
  store: {style.fill: "#e8f5e9"; style.stroke: "#2e7d32"}
  mem:   {style.fill: "#fff8e1"; style.stroke: "#f9a825"}
  ctl:   {style.fill: "#e5e7eb"; style.stroke: "#37474f"}
  bad:   {style.fill: "#ffebee"; style.stroke: "#c62828"}
}

title: "LLD - services/ingestion: the head of the data flow (Plan.md 3).\nThree goroutines, two bounded queues, one writer, no lock on the hot path." {
  style.bold: true
  style.font-size: 20
}

# --- lifecycle -------------------------------------------------------------

life: "fx lifecycle - Module: Provide(NewCandleStore, NewPipeline), Invoke(AttachBrokerLogger, RegisterHealth, (*Pipeline).Run)" {
  class: ctl
  run: "Pipeline.Run(lc fx.Lifecycle) -> lc.Append(fx.Hook{OnStart: p.Start, OnStop: p.Stop})\nAttachBrokerLogger type-asserts broker.Streamer to loggableStreamer and SetLogger: core/broker\nlogs every reconnect, and without it those go to a no-op logger" {class: go}
  start: "Pipeline.Start(ctx): runCtx = context.WithCancel(context.WithoutCancel(ctx))\nthe fx start ctx is cancelled the moment OnStart returns; the writers' flusher and the broker\nstream must outlive it. Values kept, deadline dropped. p.cancel is assigned only once BOTH\nwriters are up, so a double Start still stops the pipeline that is actually running" {class: go}
  stop: "Pipeline.Stop(ctx) - fixed order, each step depends on the previous one:\ncancel -> wg.Wait (supervisor closes upstream, so the drain is safe) -> relay drains and\ncloses queue -> process drains -> sweep once more -> Flush then Close then Err" {class: go}
  stop_timeout: "DRAIN TIMEOUT: wg.Wait outlives the fx stop deadline ->\ningestion: timed out draining %d tick(s) after shutdown. Reported, not panicked: a streamer\nthat ignores cancellation cannot be closed safely" {class: bad}
  stop_drop: "SHUTDOWN DROP: after the sweep, openBars() > 0 -> dropping incomplete candles at\nshutdown. A bar still inside its minute is a short OHLCV the feature pipeline cannot tell\nfrom a full one; its raw ticks are already durable in the tick store" {class: bad}

  run -> start: "OnStart"
  start -> stop: "OnStop"
  stop -> stop_timeout: "select ctx.Done()"
  stop -> stop_drop: "sweep(clock()) then openBars()"
}

# --- supervision -----------------------------------------------------------

super: "supervision - two layers of backoff, and why the outer one exists" {
  class: ctl
  kite: "C1 core/broker: Kite.Stream(ctx, symbols, upstream) - reconnects INTERNALLY:\nbackoffFor(attempt, k.reconnectBase, k.maxBackoff), cap broker.reconnect_max_backoff_seconds\n(default 60). Normally blocks until ctx ends" {class: ext}
  sup: "Pipeline.supervise(ctx, upstream) - defer close(upstream)\nfor attempt := 0; ; attempt++ { streamRestarts.Inc(); Stream(ctx, p.symbols, upstream)\nif ctx.Err() != nil { return }; log broker stream returned, restarting; wait(ctx, backoffFor(attempt)) }" {class: go}
  bo: "Pipeline.backoffFor(attempt): reconnectBase = defaultReconnectBase 1s, doubling, saturating\nat defaultReconnectMax 60s (overridden by broker.reconnect_max_backoff_seconds). Iterative, not\na shift, so a stream down for hours cannot overflow the duration into a NEGATIVE wait\nand become a hot loop. wait() reports whether it slept or was cancelled" {class: go}
  nosup: "UNSUPERVISED - the defect: Stream CAN return on a rejected credential, an instrument missing\nfrom the dump, or a dial that never succeeds. Re-invoked by nobody, the process kept\nreporting healthy while ingesting nothing: a process that stores nothing is indistinguishable\nfrom a process that is storing" {class: bad}

  kite -> sup: "can return"
  sup -> bo: "its own backoff, on top of the connector's"
  sup -> nosup: "without this layer"
}

# --- the three goroutines --------------------------------------------------

flow: "the three goroutines and the channel flow - one writer, no locks" {
  class: ctl
  upstream: "upstream chan broker.Tick, cap tickBufferSize = 1024\nWritten by Stream, closed by supervise once Stream has returned, so a send can never race the close" {class: mem}
  relay: "Pipeline.relay(upstream, queue): for tick := range upstream { deliver(tick, queue) }; defer close(queue)\nTakes NO context on purpose - shutdown cancels, waits for the supervisor, and only then closes\nupstream, so a context-aware relay could abandon ticks already handed over. It exists at all\nbecause the overload policy cannot live inside C1 Stream: core/broker is another component's\nfile, and blocking belongs to whoever owns the socket reader" {class: go}
  queue: "queue chan broker.Tick, cap 1024 - BIDIRECTIONAL, because dropping the oldest is a receive\nThe relay is its only writer, so an eviction cannot race another producer" {class: mem}
  proc: "Pipeline.process(queue): select { case tick, ok := <-queue: handle(tick); case <-sweep.C: sweep(clock()) }\nsweepInterval = 5s. THE SINGLE WRITER: it alone owns state, both writers and rollover, so\ncandle completion is race-free by construction rather than by discipline" {class: go}
  handle: "Pipeline.handle(tick): ticks.Append(storage.NewTick(tick)) FIRST, so a rejected fold still\narchives the raw tick; then fold(tick); then lastTickNS.Store(tick.Timestamp.UnixNano())" {class: go}
  age: "Pipeline.sampleAge(runCtx) - its own goroutine, ageInterval = 1s\nDeliberately NOT inside process: an age updated from the processor would freeze at whatever\nit last recorded precisely when the processor wedges" {class: go}

  upstream -> relay: "broker.Tick"
  relay -> queue: "deliver: evict oldest, never block"
  queue -> proc: "the single reader"
  proc -> handle: "one tick at a time"
  handle -> age: "lastTickNS, atomic.Int64"
}

# --- exactly-once bar completion ------------------------------------------

ex: "exactly-once bar completion - clear and advance, in one step, on one goroutine" {
  class: ctl
  fold: "Pipeline.fold(tick): minute = tick.Timestamp.Truncate(time.Minute)\nst = p.state[tick.Symbol]" {class: go}
  st: "symbolState: open contracts.Candle (zero Candle when no bar is open),\nclosed time.Time (minute of the last bar persisted; zero time when nothing yet)\nmap[string]symbolState, private to the processor goroutine" {class: mem}
  late: "REJECT, count and return, when !st.closed.IsZero() && !minute.After(st.closed)\nthat is, when the tick minute is AT OR BEFORE the watermark. A clock skew, a reordered\nframe or a reconnect replaying the session tail would otherwise rebuild a minute already on\ndisk and write it twice -> mft_ingestion_ticks_late_total. The raw tick is ALREADY archived\nby handle, so nothing is lost from the tick store" {class: bad}
  roll: "ROLLOVER ON A LATER TICK: if st.open.Symbol != '' && !st.open.Timestamp.Equal(minute)\nthen complete(st.open), then RE-READ the state - complete may have advanced the watermark" {class: go}
  comp: "Pipeline.complete(candle): st.open = contracts.Candle{}; st.closed = candle.Timestamp;\np.state[candle.Symbol] = st - one step, no lock - THEN candles.Append(storage.NewCandle(candle)).\nThe bar is appended once and removed from the open set in the same step, so it can never land\ntwice. That is what makes exactly-once hold rather than merely being likely" {class: go}
  swp: "ROLLOVER ON THE CLOCK: Pipeline.sweep(now): minute = now.UTC().Truncate(time.Minute)\ncomplete(st.open) where st.open.Timestamp.Before(minute). A quiet symbol emits no later tick,\nso rollover-on-next-tick alone would never write the last bar of an illiquid scrip or of a\nsession. Same goroutine, so it cannot race the rollover path; also called from Stop, which is\nsafe because Stop observes the wait group first" {class: go}
  clk: "Clock func() time.Time, default SystemClock = time.Now().UTC()\nA candle boundary is a property of the CLOCK, so the seam is injected: a rollover test sets\nthe instant under test instead of waiting for a real minute boundary" {class: ctl}

  fold -> st: "one symbol per entry"
  st -> late: "minute <= closed"
  st -> roll: "new minute arrives"
  roll -> comp: "the open bar"
  swp -> comp: "the open bar"
  comp -> clk: "cache.UpdateCandle -> toContract"
}

# --- backpressure ----------------------------------------------------------

bp: "backpressure - Pipeline.deliver(tick, queue): three NON-BLOCKING selects. It never blocks; that is the whole point." {
  class: ctl
  s1: "1  FAST PATH\nselect { case queue <- tick: queueDepth.Set(len(queue)); return; default: }\nTaken while there is room. 1024 slots is tens of seconds of slack at NSE retail tick rates" {class: go}
  s2: "2  FULL - EVICT THE OLDEST\nselect { case <-queue: ticksDropped.Inc(); default: }\nA receive, which is why queue is bidirectional. relay is its only writer, so nothing\nelse can be holding the slot" {class: bad}
  s3: "3  RE-OFFER THE NEW TICK\nselect { case queue <- tick: queueDepth.Set(len(queue))\ndefault: ticksDropped.Inc() }\nStill non-blocking, so the reader is never stalled" {class: bad}
  race: "THE RACE WINDOW: the single reader drained and re-filled the slot between 2 and 3.\nThe tick is lost AND ticksDropped is incremented a second time, so the counter counts\ndrop operations, not distinct lost ticks. Drawn, not smoothed over" {class: bad}
  why: "WHY NOT BLOCK: a stalled consumer stalls the socket reader, the reader stops replying to the\nserver ping frames Kite sends roughly every 30s, and the broker drops the session - a storage\nslowdown escalates into a reconnect storm, which is strictly worse than losing ticks of a bar\nthat is already stale.\nWHY KEEP THE NEWEST: the freshest tick is the one that sets the candle close the next inference\npull reads, and a queued tick cannot become more valuable with age." {class: ctl}

  s1 -> s2: "default: queue is full"
  s2 -> s3: "slot freed"
  s2 -> race: "default: already full again"
  s3 -> race: "default: send lost"
  why -> s2: "the policy"
}

# --- both writers ----------------------------------------------------------

w: "both writers, two fx result types" {
  class: ctl
  w1: "*storage.Writer - one for the whole platform, provided by core/fx.go NewStorageWriter\np.ticks.Append(storage.NewTick(tick)) -> data/ticks" {class: store}
  w2: "ingestion.CandleStore - a DISTINCT fx type wrapping *storage.CandleWriter, built by\nNewCandleStore(cfg) / storage.NewCandleWriterFromConfig. Append(storage.NewCandle(c))\n-> data/candles, hive-partitioned symbol=<SYMBOL>/date=<YYYY-MM-DD>\ncore/fx.go is the foundation's file and a change there conflicts with every parallel branch;\nfx distinguishes constructors by RESULT TYPE, so declaring a type it does not provide binds\nthe second writer without touching it" {class: store}
  err: "A REFUSED APPEND is not dropped: mft_ingestion_storage_append_errors_total{dataset}\nand recordError -> p.Err() -> Check -> /readyz DEGRADED. This is the fix for defect 2, where the\nold code discarded the return value and a refused append vanished with nothing to notice it" {class: bad}

  w1 -> err: "Append -> error"
  w2 -> err: "Append -> error"
}

# --- metrics and health ----------------------------------------------------

m: "metrics and health" {
  class: ctl
  counters: "mft_ingestion_ticks_processed_total, _ticks_dropped_total, _ticks_late_total,\n_candles_completed_total, _storage_append_errors_total{dataset}, _stream_restarts_total,\nand the mft_ingestion_tick_queue_depth gauge. core/metrics validates the mft_ prefix at\nregistration, so a typo stops the process at startup instead of shipping a series nobody\nis watching" {class: ctl}
  agem: "mft_ingestion_last_tick_age_seconds - THE liveness signal.\nIf it grows, the pipeline is wedged while every other check still reports healthy. Sampled\nfrom lastTickNS on its own goroutine. last == 0 means empty, not stale, which is the honest\nreading before the first tick" {class: mem}
  reg: "RegisterHealth -> metrics.DefaultChecks().Add(metrics.Checker{Name: 'ingestion-storage',\nCheck: p.Check}); Check(ctx) = Err() = firstErr - the earliest failure on ANY goroutine,\nkept by recordError under errMu and surfaced again by the fx stop hook" {class: ctl}

  counters -> agem: "the one that matters"
  reg -> agem: "not covered by Check"
}

# --- the four defects ------------------------------------------------------

was: "the ~90 lines this replaced (278be81) - four defects, each of which loses data silently.\nNow replaced by supervise, relay, complete and the injected Clock" {
  class: bad
  d1: "DEFECT 1 - p.streamer.Stream(ctx, nil, ticks): a NIL symbol list. core/broker fell back to\nits own watchlist - the same list by coincidence rather than by wiring, and the two can drift.\nNow cfg.Broker.Instruments, copied defensively into the pipeline" {class: bad}
  d2: "DEFECT 2 - p.storage.Append(storage.Tick{...}): the RETURN VALUE WAS DISCARDED.\nIt had already become an error, so a refused Parquet append vanished: no counter, no log,\nno unhealthy probe, nothing for Err to return" {class: bad}
  d3: "DEFECT 3 - storage.Tick{InstrumentToken: 0}: EVERY ROW written with token 0, so nothing\nstored could be attributed to an instrument. Now storage.NewTick(tick) carries what arrived" {class: bad}
  d4: "DEFECT 4 - processor := p.process(ticks); _ = processor: the processor ranged over a\nchannel NOBODY EVER CLOSED. A dropped socket ended the stream, the goroutine assigned its\nresult to _ and vanished, and the process kept reporting healthy while storing nothing.\ndata/candles/ stayed empty because nothing ever completed a bar" {class: bad}

  d1 -> d2 -> d3 -> d4: "all four, in the order the commit names them"
}

footer: "Derived from\n  services/ingestion/pipeline.go - Module, AttachBrokerLogger, Clock, ingestionMetrics,\n    Run, Start, Stop, supervise, backoffFor, wait, relay, deliver, process, handle, fold,\n    sweep, openBars, complete, sampleAge, toContract\n  services/ingestion/candles.go - CandleStore, NewCandleStore, Append, Start, Flush, Close, Err, Pending\n  core/broker/broker.go:27 - Streamer.Stream(ctx, symbols []string, out chan<- Tick) error\n  core/broker/stream.go - the connector's internal reconnect backoff and the server ping frame\n  core/storage/writer.go - Writer, CandleWriter, NewTick, NewCandle, Pending, Err\n  core/metrics/health.go - Checker, DefaultChecks, /readyz\n  core/config/config.go - broker.instruments, broker.reconnect_max_backoff_seconds, storage.data_dir\n  git 278be81 - the four defects, and why each one is fixed the way it is\nTunables with no key in the frozen config schema (docs/contracts.md 8): tickBufferSize = 1024,\nsweepInterval = 5s, ageInterval = 1s, defaultReconnectBase = 1s, defaultReconnectMax = 60s" {
  style.fill: "#eceff1"
  style.stroke: "#90a4ae"
  style.font-size: 13
}